            f"Learning score {learning_score:.2f}%",
            f"Adaptive adjustment {adjustment:+.2f}",
        ],
    }



def _agent_score(
    agents: List[Dict[str, Any]],
    role: str,
    default: float = 50.0,
) -> float:
    for agent in agents:
        if str(agent.get("role") or "") == role:
            return _clamp(
                _safe_float(
                    agent.get("score"),
                    default,
                )
            )

    return _clamp(default)


def _market_confidence(
    market_regime: Dict[str, Any],
) -> float:
    """
    Derive market certainty from an explicit confidence field where
    available, otherwise estimate it from the conviction multiplier.
    """

    explicit = (
        market_regime.get("confidence")
        or market_regime.get("confidence_pct")
        or market_regime.get("regime_confidence")
        or market_regime.get("regime_confidence_pct")
    )

    if explicit is not None:
        return _clamp(
            _safe_float(explicit, 50.0)
        )

    multiplier = _safe_float(
        market_regime.get("conviction_multiplier"),
        1.0,
    )

    # 1.00 = neutral certainty of 60.
    # Stronger deviation from neutral increases certainty, while the
    # risk penalty separately handles adverse regime direction.
    estimated = 60.0 + abs(multiplier - 1.0) * 100.0

    return _clamp(estimated)


def _risk_penalty(
    profile: Dict[str, Any],
    market_regime: Dict[str, Any],
) -> Dict[str, Any]:
    risk_level = str(
        profile.get("risk_level")
        or profile.get("risk")
        or ""
    ).strip().upper()

    volatility = abs(
        _safe_float(
            profile.get("volatility_pct"),
            0.0,
        )
    )

    drawdown = abs(
        _safe_float(
            profile.get("maximum_drawdown_pct"),
            0.0,
        )
    )

    regime_name = str(
        market_regime.get("regime")
        or market_regime.get("market_regime")
        or market_regime.get("name")
        or market_regime.get("state")
        or ""
    ).strip().upper()

    penalty = 0.0
    reasons: List[str] = []

    if "HIGH" in risk_level:
        penalty += 10.0
        reasons.append("High risk level")
    elif "MEDIUM" in risk_level or "MODERATE" in risk_level:
        penalty += 4.0
        reasons.append("Moderate risk level")

    if volatility >= 60:
        penalty += 8.0
        reasons.append("Very high volatility")
    elif volatility >= 40:
        penalty += 4.0
        reasons.append("Elevated volatility")

    if drawdown >= 25:
        penalty += 5.0
        reasons.append("Large historical drawdown")
    elif drawdown >= 15:
        penalty += 2.0
        reasons.append("Moderate historical drawdown")

    if any(
        value in regime_name
        for value in (
            "BEAR",
            "CORRECTION",
            "DOWNTREND",
        )
    ):
        penalty += 5.0
        reasons.append("Adverse market regime")

    if "HIGH VOLATILITY" in regime_name:
        penalty += 3.0
        reasons.append("High-volatility market regime")

    return {
        "value": round(
            min(penalty, 25.0),
            2,
        ),
        "reasons": reasons,
        "risk_level": risk_level or "UNKNOWN",
        "volatility_pct": round(volatility, 2),
        "maximum_drawdown_pct": round(drawdown, 2),
        "market_regime": regime_name or "UNKNOWN",
    }


def _calculate_confidence(
    profile: Dict[str, Any],
    learning: Dict[str, Any],
    market_regime: Dict[str, Any],
    agents: List[Dict[str, Any]],
    committee_score: float,
    consensus: Dict[str, Any],
) -> Dict[str, Any]:
    """
    Calculate decision confidence separately from the committee score.

    Committee score measures attractiveness.
    Confidence measures reliability and agreement behind that score.
    """

    agreement = _clamp(
        _safe_float(
            consensus.get("agreement_pct"),
            0.0,
        )
    )

    institutional = _agent_score(
        agents,
        "Institutional Intelligence",
    )

    learning_quality = _agent_score(
        agents,
        "Adaptive Intelligence",
    )

    technical = _agent_score(
        agents,
        "Technical Analysis",
    )

    market = _market_confidence(
        market_regime
    )

    components = {
        "committee_component": round(
            _clamp(committee_score) * 0.40,
            2,
        ),
        "agreement_component": round(
            agreement * 0.20,
            2,
        ),
        "institutional_component": round(
            institutional * 0.15,
            2,
        ),
        "learning_component": round(
            learning_quality * 0.10,
            2,
        ),
        "market_component": round(
            market * 0.10,
            2,
        ),
        "technical_component": round(
            technical * 0.05,
            2,
        ),
    }

    base_confidence = sum(components.values())
    penalty = _risk_penalty(
        profile,
        market_regime,
    )

    calibrated = _clamp(
        base_confidence - penalty["value"]
    )

    return {
        "confidence": _safe_int(calibrated),
        "raw_confidence": round(
            base_confidence,
            2,
        ),
        "risk_penalty": penalty["value"],
        "components": components,
        "inputs": {
            "committee_score": round(
                _clamp(committee_score),
                2,
            ),
            "agreement_pct": round(
                agreement,
                2,
            ),
            "institutional_score": round(
                institutional,
                2,
            ),
            "learning_score": round(
                learning_quality,
                2,
            ),
            "market_confidence": round(
                market,
                2,
            ),
            "technical_score": round(
                technical,
                2,
            ),
        },
        "penalty_details": penalty,
        "formula_version": "8.2",
    }


def build_committee_decision(
    profile: Dict[str, Any],
    learning: Dict[str, Any],
    market_regime: Dict[str, Any],
) -> Dict[str, Any]:
    agents = [
        _technical_vote(profile),
        _quant_vote(profile),
        _institutional_vote(profile),
        _risk_vote(profile),
        _learning_vote(profile, learning),
    ]

    weights = {
        "Technical Analysis": 0.22,
        "Predictive Intelligence": 0.28,
        "Institutional Intelligence": 0.20,
        "Risk Control": 0.20,
        "Adaptive Intelligence": 0.10,
    }

    weighted_score = sum(
        agent["score"]
        * weights.get(agent["role"], 0.0)
        for agent in agents
    )

    regime_multiplier = _safe_float(
        market_regime.get("conviction_multiplier"),
        1.0,
    )

    final_score = _clamp(
        weighted_score * regime_multiplier
    )

    final_decision = _decision_from_score(
        final_score
    )

    votes = Counter(
        agent["decision"]
        for agent in agents
    )

    consensus_count = votes.most_common(1)[0][1]
    consensus_pct = round(
        consensus_count / len(agents) * 100,
        2,
    )

    consensus = _build_consensus(
        agents,
        final_decision,
    )


    confidence_calibration = _calculate_confidence(
        profile=profile,
        learning=learning,
        market_regime=market_regime,
        agents=agents,
        committee_score=final_score,
        consensus=consensus,
    )

    reasons: List[str] = []
    for agent in agents:
        for reason in agent["reasons"]:
            if reason not in reasons:
                reasons.append(reason)

    return {
        "symbol": profile.get("symbol"),
        "name": profile.get("name"),
        "price": profile.get("price"),
        "final_decision": final_decision,
        "confidence": confidence_calibration["confidence"],
        "confidence_breakdown": confidence_calibration,
        "raw_confidence": confidence_calibration["raw_confidence"],
        "confidence_risk_penalty": confidence_calibration["risk_penalty"],
        "consensus": consensus,
        "consensus_count": consensus["aligned_count"],
        "consensus_pct": consensus["agreement_pct"],
        "agreement_pct": consensus["agreement_pct"],
        "dissent_count": consensus["dissent_count"],
        "dissenting_members": consensus["dissenting_members"],
        "consensus_strength": consensus["strength"],
        "committee_score": round(
            final_score,
            2,
        ),
        "vote_distribution": dict(votes),
        "market_regime":
            market_regime.get("regime"),
        "market_regime_badge":
            market_regime.get("badge"),
        "conviction_score":
            profile.get("conviction_score"),
        "expected_return":
            profile.get("expected_return"),
        "target_price":
            profile.get("target_price"),
        "risk_level":
            profile.get("risk_level"),
        "institutional_signal":
            profile.get("institutional_signal"),
        "agents": agents,
        "reasons": reasons[:8],
    }


def build_ai_investment_committee(
    prediction_center: Dict[str, Any] | None = None,
) -> Dict[str, Any]:
    if prediction_center is None:
        prediction_center = build_prediction_center()

    profiles = prediction_center.get(
        "predictions",
        [],
    )
    learning = prediction_center.get(
        "learning",
        {},
    )
    market_regime = prediction_center.get(
        "market_regime",
        {},
    )

    decisions = [
        build_committee_decision(
            profile=profile,
            learning=learning,
            market_regime=market_regime,
        )
        for profile in profiles
    ]

    decisions.sort(
        key=lambda item: (
            item["committee_score"],
            item["confidence"],
        ),
        reverse=True,
    )

    decision_counts = Counter(
        item["final_decision"]
        for item in decisions
    )

    return {
        "version":
            "11.7 AI Investment Committee",
        "generated_at": datetime.now(
            KENYA_TIMEZONE
        ).isoformat(),
        "market_regime": market_regime,
        "decision_count": len(decisions),
        "summary": {
            "strong_buy_count":
                decision_counts.get(
                    "STRONG BUY",
                    0,
                ),
            "buy_count":
                decision_counts.get(
                    "BUY",
                    0,
                ),
            "hold_count":
                decision_counts.get(
                    "HOLD",
                    0,
                ),
            "watch_count":
                decision_counts.get(
                    "WATCH",
                    0,
                ),
            "avoid_count":
                decision_counts.get(
                    "AVOID",
                    0,
                ),
            "top_symbol":
                decisions[0]["symbol"]
                if decisions
                else None,
            "top_score":
                decisions[0]["committee_score"]
                if decisions
                else 0,
        },
        "decisions": decisions,
    }
