def _safe_float(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def _safe_int(value: Any, default: int = 0) -> int:
    try:
        return int(round(float(value)))
    except (TypeError, ValueError):
        return default


def _clamp(
    value: float,
    minimum: float = 0.0,
    maximum: float = 100.0,
) -> float:
    return max(minimum, min(maximum, value))


def _decision_from_score(score: float) -> str:
    if score >= 88:
        return "STRONG BUY"
    if score >= 74:
        return "BUY"
    if score >= 58:
        return "HOLD"
    if score >= 44:
        return "WATCH"
    return "AVOID"



def _decision_direction(decision: Any) -> str:
    """Normalize committee decisions into comparable vote directions."""

    value = str(decision or "").strip().upper()

    if value in {"STRONG BUY", "BUY"}:
        return "BULLISH"

    if value in {"AVOID", "SELL", "STRONG SELL"}:
        return "BEARISH"

    return "NEUTRAL"


def _consensus_strength(agreement_pct: float) -> str:
    if agreement_pct >= 80:
        return "STRONG"

    if agreement_pct >= 60:
        return "MODERATE"

    return "WEAK"


def _build_consensus(
    agents: List[Dict[str, Any]],
    final_decision: str,
) -> Dict[str, Any]:
    """
    Measure agreement with the final committee direction.

    Exact labels such as BUY and STRONG BUY are treated as the same
    bullish direction. HOLD and WATCH are treated as neutral.
    """

    final_direction = _decision_direction(final_decision)

    aligned = [
        agent
        for agent in agents
        if _decision_direction(agent.get("decision"))
        == final_direction
    ]

    dissenting = [
        agent
        for agent in agents
        if _decision_direction(agent.get("decision"))
        != final_direction
    ]

    member_count = len(agents)
    aligned_count = len(aligned)

    agreement_pct = (
        round(aligned_count / member_count * 100, 2)
        if member_count
        else 0.0
    )

    direction_counts = Counter(
        _decision_direction(agent.get("decision"))
        for agent in agents
    )

    return {
        "final_direction": final_direction,
        "member_count": member_count,
        "aligned_count": aligned_count,
        "dissent_count": len(dissenting),
        "agreement_pct": agreement_pct,
        "strength": _consensus_strength(agreement_pct),
        "aligned_members": [
            agent.get("name")
            for agent in aligned
        ],
        "dissenting_members": [
            agent.get("name")
            for agent in dissenting
        ],
        "direction_counts": {
            "bullish": direction_counts.get("BULLISH", 0),
            "neutral": direction_counts.get("NEUTRAL", 0),
            "bearish": direction_counts.get("BEARISH", 0),
        },
    }


def _technical_vote(profile: Dict[str, Any]) -> Dict[str, Any]:
    score = 50.0
    trend = str(profile.get("trend") or "").upper()
    rsi = _safe_float(profile.get("rsi"), 50.0)
    macd = _safe_float(profile.get("macd"), 0.0)
    reasons: List[str] = []

    if "UPTREND" in trend or "BULL" in trend:
        score += 24
        reasons.append("Bullish technical trend")
    elif "DOWNTREND" in trend or "BEAR" in trend:
        score -= 24
        reasons.append("Bearish technical trend")

    if 50 <= rsi <= 68:
        score += 14
        reasons.append("RSI supports positive momentum")
    elif rsi >= 75:
        score -= 8
        reasons.append("RSI indicates overbought conditions")
    elif rsi <= 35:
        score -= 10
        reasons.append("RSI indicates weak momentum")

    if macd > 0:
        score += 12
        reasons.append("Positive MACD")
    elif macd < 0:
        score -= 12
        reasons.append("Negative MACD")

    score = _clamp(score)

    return {
        "name": "Technical Analyst",
        "role": "Technical Analysis",
        "score": round(score, 2),
        "decision": _decision_from_score(score),
        "confidence": _safe_int(score),
        "reasons": reasons[:3],
    }


def _quant_vote(profile: Dict[str, Any]) -> Dict[str, Any]:
    conviction = _safe_float(
        profile.get("conviction_score"),
        50.0,
    )
    probability = _safe_float(
        profile.get("prediction_probability_pct"),
        50.0,
    )
    expected_return = _safe_float(
        profile.get("expected_return"),
        0.0,
    )

    return_component = _clamp(
        50.0 + expected_return * 2.5
    )

    score = (
        conviction * 0.50
        + probability * 0.30
        + return_component * 0.20
    )

    return {
        "name": "Quantitative Analyst",
        "role": "Predictive Intelligence",
        "score": round(score, 2),
        "decision": _decision_from_score(score),
        "confidence": _safe_int(score),
        "reasons": [
            f"Conviction score {conviction:.0f}",
            f"Prediction probability {probability:.1f}%",
            f"Expected return {expected_return:+.2f}%",
        ],
    }



def _first_profile_value(
    profile: Dict[str, Any],
    keys: List[str],
    default: Any = None,
) -> Any:
    for key in keys:
        value = profile.get(key)

        if value is not None and value != "":
            return value

    return default


def _normalise_ratio(
    value: Any,
    default: float = 1.0,
) -> float:
    ratio = _safe_float(value, default)

    # Some upstream producers may expose percentages instead of ratios.
    if ratio > 20:
        ratio = ratio / 100.0

    return max(ratio, 0.0)


def _accumulation_score(
    profile: Dict[str, Any],
) -> Dict[str, Any]:
    signal = str(
        _first_profile_value(
            profile,
            [
                "institutional_signal",
                "flow_signal",
                "volume_signal",
            ],
            "",
        )
    ).strip().upper()

    persistence = _safe_float(
        _first_profile_value(
            profile,
            [
                "accumulation_persistence",
                "accumulation_persistence_pct",
                "institutional_persistence",
                "buying_persistence",
            ],
            50.0,
        ),
        50.0,
    )

    days = _safe_float(
        _first_profile_value(
            profile,
            [
                "accumulation_days",
                "institutional_buying_days",
                "positive_volume_days",
            ],
            0.0,
        ),
        0.0,
    )

    if any(
        term in signal
        for term in (
            "STRONG ACCUMULATION",
            "HEAVY ACCUMULATION",
            "AGGRESSIVE BUYING",
        )
    ):
        signal_score = 95.0
    elif any(
        term in signal
        for term in (
            "ACCUMULATION",
            "BUYING",
            "INFLOW",
        )
    ):
        signal_score = 80.0
    elif any(
        term in signal
        for term in (
            "STRONG DISTRIBUTION",
            "HEAVY DISTRIBUTION",
            "AGGRESSIVE SELLING",
        )
    ):
        signal_score = 15.0
    elif any(
        term in signal
        for term in (
            "DISTRIBUTION",
            "SELLING",
            "OUTFLOW",
        )
    ):
        signal_score = 30.0
    else:
        signal_score = 50.0

    if days >= 8:
        days_score = 95.0
    elif days >= 5:
        days_score = 82.0
    elif days >= 3:
        days_score = 70.0
    elif days >= 1:
        days_score = 58.0
    else:
        days_score = 50.0

    score = _clamp(
        signal_score * 0.55
        + _clamp(persistence) * 0.30
        + days_score * 0.15
    )

    return {
        "score": round(score, 2),
        "signal": signal or "UNKNOWN",
        "persistence": round(
            _clamp(persistence),
            2,
        ),
        "days": int(days),
    }


def _relative_volume_quality(
    profile: Dict[str, Any],
) -> Dict[str, Any]:
    relative_volume = _normalise_ratio(
        _first_profile_value(
            profile,
            [
                "relative_volume",
                "relative_volume_ratio",
                "volume_ratio",
                "rvol",
            ],
            1.0,
        )
    )

    if relative_volume >= 5.0:
        score = 82.0
        classification = "EXTREME"
    elif relative_volume >= 3.0:
        score = 94.0
        classification = "VERY STRONG"
    elif relative_volume >= 2.0:
        score = 88.0
        classification = "STRONG"
    elif relative_volume >= 1.4:
        score = 76.0
        classification = "HEALTHY"
    elif relative_volume >= 0.8:
        score = 58.0
        classification = "NORMAL"
    elif relative_volume >= 0.4:
        score = 40.0
        classification = "WEAK"
    else:
        score = 25.0
        classification = "VERY WEAK"

    return {
        "score": score,
        "relative_volume": round(
            relative_volume,
            2,
        ),
        "classification": classification,
    }


def _liquidity_quality(
    profile: Dict[str, Any],
) -> Dict[str, Any]:
    explicit = _first_profile_value(
        profile,
        [
            "liquidity_score",
            "liquidity_quality_score",
            "market_liquidity_score",
        ],
        None,
    )

    if explicit is not None:
        score = _clamp(
            _safe_float(explicit, 50.0)
        )
    else:
        turnover = _safe_float(
            _first_profile_value(
                profile,
                [
                    "turnover",
                    "turnover_value",
                    "value_traded",
                    "market_value_traded",
                ],
                0.0,
            ),
            0.0,
        )

        volume = _safe_float(
            _first_profile_value(
                profile,
                [
                    "volume",
                    "traded_volume",
                    "shares_traded",
                ],
                0.0,
            ),
            0.0,
        )

        spread = abs(
            _safe_float(
                _first_profile_value(
                    profile,
                    [
                        "spread_pct",
                        "bid_ask_spread_pct",
                    ],
                    0.0,
                ),
                0.0,
            )
        )

        if turnover >= 50_000_000 or volume >= 2_000_000:
            score = 94.0
        elif turnover >= 10_000_000 or volume >= 500_000:
            score = 84.0
        elif turnover >= 2_000_000 or volume >= 100_000:
            score = 72.0
        elif turnover >= 500_000 or volume >= 25_000:
            score = 58.0
        elif turnover > 0 or volume > 0:
            score = 42.0
        else:
            # Missing liquidity data is neutral rather than punitive.
            score = 50.0

        if spread >= 5:
            score -= 20
        elif spread >= 3:
            score -= 12
        elif spread >= 1.5:
            score -= 5

        score = _clamp(score)

    if score >= 80:
        quality = "HIGH"
    elif score >= 60:
        quality = "MEDIUM"
    elif score >= 45:
        quality = "LIMITED"
    else:
        quality = "LOW"

    return {
        "score": round(score, 2),
        "quality": quality,
    }


def _volume_consistency_score(
    profile: Dict[str, Any],
) -> Dict[str, Any]:
    explicit = _first_profile_value(
        profile,
        [
            "volume_consistency",
            "volume_consistency_score",
            "participation_consistency",
            "institutional_consistency",
        ],
        None,
    )

    if explicit is not None:
        score = _clamp(
            _safe_float(explicit, 50.0)
        )
    else:
        positive_days = _safe_float(
            _first_profile_value(
                profile,
                [
                    "positive_volume_days",
                    "accumulation_days",
                    "institutional_buying_days",
                ],
                0.0,
            ),
            0.0,
        )

        observed_days = _safe_float(
            _first_profile_value(
                profile,
                [
                    "volume_observation_days",
                    "lookback_days",
                    "history_days",
                ],
                10.0,
            ),
            10.0,
        )

        if observed_days <= 0:
            observed_days = 10.0

        participation_ratio = (
            positive_days / observed_days
        ) * 100.0

        score = _clamp(
            45.0 + participation_ratio * 0.55
        )

    if score >= 80:
        quality = "PERSISTENT"
    elif score >= 65:
        quality = "CONSISTENT"
    elif score >= 45:
        quality = "MIXED"
    else:
        quality = "UNSTABLE"

    return {
        "score": round(score, 2),
        "quality": quality,
    }


def _abnormal_volume_assessment(
    profile: Dict[str, Any],
    relative_volume: float,
) -> Dict[str, Any]:
    explicit_flag = _first_profile_value(
        profile,
        [
            "abnormal_volume",
            "volume_anomaly",
            "is_abnormal_volume",
        ],
        None,
    )

    z_score = abs(
        _safe_float(
            _first_profile_value(
                profile,
                [
                    "volume_zscore",
                    "volume_z_score",
                    "volume_anomaly_zscore",
                ],
                0.0,
            ),
            0.0,
        )
    )

    consistency = _safe_float(
        _first_profile_value(
            profile,
            [
                "volume_consistency",
                "volume_consistency_score",
                "participation_consistency",
            ],
            50.0,
        ),
        50.0,
    )

    explicit_abnormal = False

    if isinstance(explicit_flag, bool):
        explicit_abnormal = explicit_flag
    elif explicit_flag is not None:
        explicit_abnormal = str(
            explicit_flag
        ).strip().upper() in {
            "TRUE",
            "YES",
            "Y",
            "1",
            "ABNORMAL",
        }

    abnormal = (
        explicit_abnormal
        or z_score >= 3.5
        or (
            relative_volume >= 5.0
            and consistency < 55
        )
    )

    if abnormal:
        score = 25.0
        classification = "ABNORMAL SPIKE"
    elif z_score >= 2.5 or relative_volume >= 4.0:
        score = 55.0
        classification = "ELEVATED"
    elif relative_volume >= 1.4:
        score = 88.0
        classification = "HEALTHY EXPANSION"
    else:
        score = 70.0
        classification = "NORMAL"

    return {
        "score": score,
        "abnormal": abnormal,
        "classification": classification,
        "z_score": round(z_score, 2),
    }


def _institutional_quality(
    score: float,
    abnormal_volume: bool,
) -> str:
    if abnormal_volume and score < 75:
        return "SPECULATIVE"

    if score >= 85:
        return "VERY HIGH"

    if score >= 74:
        return "HIGH"

    if score >= 60:
        return "MODERATE"

    if score >= 45:
        return "WEAK"

    return "VERY WEAK"


def _institutional_vote(
    profile: Dict[str, Any],
) -> Dict[str, Any]:
    confidence = _clamp(
        _safe_float(
            profile.get("institutional_confidence"),
            50.0,
        )
    )

    accumulation = _accumulation_score(profile)
    relative_volume = _relative_volume_quality(
        profile
    )
    liquidity = _liquidity_quality(profile)
    consistency = _volume_consistency_score(
        profile
    )
    abnormal = _abnormal_volume_assessment(
        profile,
        relative_volume["relative_volume"],
    )

    score_components = {
        "accumulation": round(
            accumulation["score"] * 0.25,
            2,
        ),
        "relative_volume": round(
            relative_volume["score"] * 0.20,
            2,
        ),
        "liquidity": round(
            liquidity["score"] * 0.15,
            2,
        ),
        "volume_consistency": round(
            consistency["score"] * 0.15,
            2,
        ),
        "institutional_conviction": round(
            confidence * 0.15,
            2,
        ),
        "abnormal_volume_quality": round(
            abnormal["score"] * 0.10,
            2,
        ),
    }

    score = _clamp(
        sum(score_components.values())
    )

    quality = _institutional_quality(
        score,
        abnormal["abnormal"],
    )

    reasons: List[str] = []

    if accumulation["score"] >= 75:
        reasons.append(
            f'{accumulation["signal"].title()} '
            f'with {accumulation["persistence"]:.0f}% persistence'
        )
    elif accumulation["score"] <= 40:
        reasons.append(
            f'Weak institutional flow: '
            f'{accumulation["signal"].title()}'
        )

    if relative_volume["relative_volume"] >= 1.4:
        reasons.append(
            f'Relative volume '
            f'{relative_volume["relative_volume"]:.2f}× '
            f'({relative_volume["classification"].lower()})'
        )

    if liquidity["quality"] in {
        "LOW",
        "LIMITED",
    }:
        reasons.append(
            f'{liquidity["quality"].title()} liquidity quality'
        )

    if abnormal["abnormal"]:
        reasons.append(
            "Abnormal volume spike detected"
        )
    elif consistency["score"] >= 70:
        reasons.append(
            f'{consistency["quality"].title()} '
            f'volume participation'
        )

    if not reasons:
        reasons.append(
            "Institutional participation is neutral"
        )

    return {
        "name": "Institutional Flow Analyst",
        "role": "Institutional Intelligence",
        "score": round(score, 2),
        "decision": _decision_from_score(score),
        "confidence": _safe_int(score),
        "reasons": reasons[:4],
        "institutional_quality": quality,
        "institutional_confidence": round(
            confidence,
            2,
        ),
        "accumulation_score": accumulation["score"],
        "accumulation_persistence":
            accumulation["persistence"],
        "accumulation_days": accumulation["days"],
        "relative_volume_score":
            relative_volume["score"],
        "relative_volume":
            relative_volume["relative_volume"],
        "relative_volume_classification":
            relative_volume["classification"],
        "liquidity_score": liquidity["score"],
        "liquidity_quality": liquidity["quality"],
        "volume_consistency_score":
            consistency["score"],
        "volume_consistency_quality":
            consistency["quality"],
        "abnormal_volume": abnormal["abnormal"],
        "abnormal_volume_score": abnormal["score"],
        "abnormal_volume_classification":
            abnormal["classification"],
        "volume_z_score": abnormal["z_score"],
        "score_components": score_components,
        "formula_version": "8.3",
    }



def _risk_vote(profile: Dict[str, Any]) -> Dict[str, Any]:
    risk = str(
        profile.get("risk_level")
        or "INSUFFICIENT HISTORY"
    ).upper()

    volatility = abs(
        _safe_float(
            profile.get("volatility_pct"),
            0.0,
        )
    )
    drawdown = abs(
        _safe_float(
            profile.get("maximum_drawdown_pct"),
            0.0,
        )
    )
    sharpe = _safe_float(
        profile.get("sharpe_ratio"),
        0.0,
    )

    score = {
        "LOW": 82.0,
        "MEDIUM": 65.0,
        "HIGH": 40.0,
        "INSUFFICIENT HISTORY": 48.0,
    }.get(risk, 50.0)

    reasons = [f"Risk level {risk}"]

    if sharpe >= 2:
        score += 10
        reasons.append(
            f"Strong Sharpe ratio {sharpe:.2f}"
        )
    elif sharpe < 0:
        score -= 10
        reasons.append(
            f"Negative Sharpe ratio {sharpe:.2f}"
        )

    if volatility >= 60:
        score -= 10
        reasons.append(
            f"High volatility {volatility:.2f}%"
        )

    if drawdown >= 25:
        score -= 10
        reasons.append(
            f"Large drawdown {drawdown:.2f}%"
        )

    score = _clamp(score)

    return {
        "name": "Risk Manager",
        "role": "Risk Control",
        "score": round(score, 2),
        "decision": _decision_from_score(score),
        "confidence": _safe_int(score),
        "reasons": reasons[:3],
    }


