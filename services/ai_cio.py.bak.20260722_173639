def _risk_adjustment(
    decision: AICIODecision,
) -> float:
    risk_veto = bool(
        _decision_value(
            decision,
            "risk_veto",
            False,
        )
    )

    if risk_veto:
        return -35.0

    risk_status = _upper(
        _decision_value(
            decision,
            "risk_status",
            "INSUFFICIENT_DATA",
        )
    )

    adjustments = {
        "APPROVED": 3.0,
        "APPROVED_WITH_CAUTION": -3.0,
        "VETOED": -35.0,
        "INSUFFICIENT_DATA": -7.0,
    }

    return adjustments.get(
        risk_status,
        -7.0,
    )



def _regime_adjustment(
    decision: AICIODecision,
) -> float:
    """
    Apply directional and volatility-aware ranking adjustments.
    """
    regime = _normalize_market_regime(
        _decision_value(
            decision,
            "market_regime",
            "UNKNOWN",
        )
    )

    action = _normalize_decision(
        _decision_value(
            decision,
            "decision",
            "HOLD",
        ),
        _decision_value(
            decision,
            "decision_score",
            50.0,
        ),
    )

    bullish_action = action in {
        "STRONG_BUY",
        "BUY",
    }

    bearish_action = action in {
        "REDUCE",
        "SELL",
        "AVOID",
    }

    bullish_regimes = {
        "STRONG_BULLISH",
        "BULLISH",
    }

    bearish_regimes = {
        "BEARISH",
        "STRONG_BEARISH",
    }

    if bullish_action and regime in bullish_regimes:
        return 4.0

    if bullish_action and regime in bearish_regimes:
        return -8.0

    if bearish_action and regime in bearish_regimes:
        return 3.0

    if bearish_action and regime in bullish_regimes:
        return -2.0

    if regime == "CAUTIOUS" and bullish_action:
        return -4.0

    if regime == "HIGH_VOLATILITY":
        if bullish_action:
            return -7.0

        if bearish_action:
            return 1.0

        return -2.0

    if regime == "LOW_VOLATILITY":
        if bullish_action:
            return 2.0

        if bearish_action:
            return -1.0

        return 1.0

    if regime == "NORMAL_VOLATILITY":
        return 0.0

    if regime == "UNKNOWN":
        return -2.0

    return 0.0

def _data_quality_score(
    decision: AICIODecision,
) -> float:
    supporting = _supporting_engines_mapping(
        decision
    )

    if supporting:
        expected = (
            "prediction_center",
            "investment_committee",
            "risk_engine",
            "portfolio_optimizer",
            "screener_engine",
            "learning_engine",
            "market_regime_engine",
            "market_breadth",
        )

        available = sum(
            1
            for key in expected
            if bool(supporting.get(key))
        )

        return round(
            100.0 * available / len(expected),
            2,
        )

    source_metadata = _decision_value(
        decision,
        "source_metadata",
        {},
    )

    if isinstance(source_metadata, Mapping):
        available_sources = source_metadata.get(
            "available_sources",
            {},
        )

        if isinstance(available_sources, Mapping):
            total = len(available_sources)

            if total > 0:
                available = sum(
                    1
                    for value in available_sources.values()
                    if bool(value)
                )

                return round(
                    100.0 * available / total,
                    2,
                )

    return 0.0


def _expected_return_score(
    decision: AICIODecision,
) -> float:
    price_plan = _decision_value(
        decision,
        "price_plan",
        {},
    )

    if not isinstance(price_plan, Mapping):
        try:
            price_plan = _dataclass_asdict(
                price_plan
            )
        except (TypeError, ValueError):
            price_plan = {}

    expected_return = _safe_float(
        price_plan.get(
            "expected_return_pct",
            0.0,
        )
    )

    downside = abs(
        _safe_float(
            price_plan.get(
                "downside_risk_pct",
                0.0,
            )
        )
    )

    risk_reward = _safe_float(
        price_plan.get(
            "risk_reward_ratio",
            0.0,
        )
    )

    expected_component = _clamp(
        50.0 + expected_return * 2.5,
        0.0,
        100.0,
    )

    downside_penalty = _clamp(
        downside * 1.5,
        0.0,
        30.0,
    )

    risk_reward_bonus = _clamp(
        risk_reward * 5.0,
        0.0,
        20.0,
    )

    return round(
        _clamp(
            expected_component
            - downside_penalty
            + risk_reward_bonus,
            0.0,
            100.0,
        ),
        2,
    )


def _build_ranking_reasons(
    decision: AICIODecision,
    *,
    score_values: MappingType,
    executive_score: float,
    risk_adjustment: float,
    regime_adjustment: float,
    data_quality_score: float,
) -> List[str]:
    reasons: List[str] = []

    decision_value = _normalize_decision(
        _decision_value(
            decision,
            "decision",
            "HOLD",
        ),
        _decision_value(
            decision,
            "decision_score",
            50.0,
        ),
    )

    confidence = _normalized_score_value(
        _decision_value(
            decision,
            "confidence",
            0.0,
        )
    )

    if executive_score >= 80:
        reasons.append(
            "High executive composite score"
        )
    elif executive_score >= 65:
        reasons.append(
            "Positive executive composite score"
        )
    elif executive_score < 40:
        reasons.append(
            "Weak executive composite score"
        )

    if decision_value in {
        "STRONG_BUY",
        "BUY",
    }:
        reasons.append(
            f"Committee action is {decision_value}"
        )

    if confidence >= 80:
        reasons.append(
            "High decision confidence"
        )
    elif confidence < 50:
        reasons.append(
            "Low decision confidence"
        )

    strongest = sorted(
        (
            (
                key,
                _normalized_score_value(value),
            )
            for key, value in score_values.items()
        ),
        key=lambda item: item[1],
        reverse=True,
    )

    for key, value in strongest[:2]:
        if value >= 70:
            reasons.append(
                f"Strong {key.replace('_', ' ')} score"
            )

    if risk_adjustment <= -20:
        reasons.append(
            "Risk engine materially reduced ranking"
        )
    elif risk_adjustment > 0:
        reasons.append(
            "Risk approval supports the opportunity"
        )

    if regime_adjustment > 0:
        reasons.append(
            "Decision aligns with market regime"
        )
    elif regime_adjustment < 0:
        reasons.append(
            "Decision conflicts with market regime"
        )

    if data_quality_score < 50:
        reasons.append(
            "Limited specialist-engine coverage"
        )
    elif data_quality_score >= 75:
        reasons.append(
            "Broad specialist-engine coverage"
        )

    original_reasons = _decision_value(
        decision,
        "ranking_reasons",
        [],
    )

    if isinstance(original_reasons, str):
        original_reasons = [
            original_reasons
        ]

    if isinstance(
        original_reasons,
        (list, tuple),
    ):
        for reason in original_reasons:
            text = str(reason or "").strip()

            if text and text not in reasons:
                reasons.append(text)

    return reasons[:10]


def calculate_executive_score(
    decision: AICIODecision,
    *,
    weights: Optional[AICIORankingWeights] = None,
) -> Dict[str, Any]:
    """
    Calculate a transparent, risk-adjusted executive opportunity score.
    """

    ranking_weights = (
        weights or AICIORankingWeights()
    ).normalized()

    scores = _score_mapping(decision)

    committee_score = _normalized_score_value(
        scores.get(
            "committee",
            _decision_value(
                decision,
                "decision_score",
                50.0,
            ),
        ),
        50.0,
    )

    prediction_score = _normalized_score_value(
        scores.get(
            "prediction",
            50.0,
        ),
        50.0,
    )

    technical_score = _normalized_score_value(
        scores.get(
            "technical",
            50.0,
        ),
        50.0,
    )

    institutional_score = _normalized_score_value(
        scores.get(
            "institutional",
            50.0,
        ),
        50.0,
    )

    volume_score = _normalized_score_value(
        scores.get(
            "volume",
            50.0,
        ),
        50.0,
    )

    consensus_score = _normalized_score_value(
        scores.get(
            "consensus",
            _decision_value(
                decision,
                "committee_consensus",
                50.0,
            ),
        ),
        50.0,
    )

    market_regime_score = _normalized_score_value(
        scores.get(
            "market_regime",
            _regime_numeric_score(
                _decision_value(
                    decision,
                    "market_regime",
                    "UNKNOWN",
                )
            ),
        ),
        50.0,
    )

    learning_score = _normalized_score_value(
        scores.get(
            "learning",
            50.0,
        ),
        50.0,
    )

    portfolio_fit_score = _normalized_score_value(
        scores.get(
            "portfolio_fit",
            50.0,
        ),
        50.0,
    )

    risk_score = _normalized_score_value(
        scores.get(
            "risk",
            50.0,
        ),
        50.0,
    )

    score_values = {
        "committee": committee_score,
        "prediction": prediction_score,
        "technical": technical_score,
        "institutional": institutional_score,
        "volume": volume_score,
        "consensus": consensus_score,
        "market_regime": market_regime_score,
        "learning": learning_score,
        "portfolio_fit": portfolio_fit_score,
        "risk": risk_score,
    }

    base_score = sum(
        score_values[key]
        * ranking_weights[key]
        for key in ranking_weights
    )

    confidence_score = _normalized_score_value(
        _decision_value(
            decision,
            "confidence",
            0.0,
        )
    )

    opportunity_score = _expected_return_score(
        decision
    )

    quality_score = _data_quality_score(
        decision
    )

    base_with_confidence = (
        base_score * 0.72
        + confidence_score * 0.13
        + opportunity_score * 0.10
        + quality_score * 0.05
    )

    risk_delta = _risk_adjustment(
        decision
    )

    regime_delta = _regime_adjustment(
        decision
    )

    conviction_delta = _conviction_adjustment(
        _decision_value(
            decision,
            "conviction",
            "MEDIUM",
        )
    )

    action_delta = _decision_action_adjustment(
        _decision_value(
            decision,
            "decision",
            "HOLD",
        )
    )

    executive_score = round(
        _clamp(
            base_with_confidence
            + risk_delta
            + regime_delta
            + conviction_delta
            + action_delta,
            0.0,
            100.0,
        ),
        2,
    )

    reasons = _build_ranking_reasons(
        decision,
        score_values=score_values,
        executive_score=executive_score,
        risk_adjustment=risk_delta,
        regime_adjustment=regime_delta,
        data_quality_score=quality_score,
    )

    return {
        "executive_score": executive_score,
        "base_score": round(base_score, 2),
        "confidence_score": round(
            confidence_score,
            2,
        ),
        "opportunity_score": round(
            opportunity_score,
            2,
        ),
        "risk_adjustment": round(
            risk_delta,
            2,
        ),
        "regime_adjustment": round(
            regime_delta,
            2,
        ),
        "conviction_adjustment": round(
            conviction_delta,
            2,
        ),
        "action_adjustment": round(
            action_delta,
            2,
        ),
        "data_quality_score": round(
            quality_score,
            2,
        ),
        "ranking_reasons": reasons,
        "score_components": score_values,
        "weights": ranking_weights,
    }


def rank_ai_cio_decisions(
    decisions: Sequence[AICIODecision],
    *,
    weights: Optional[AICIORankingWeights] = None,
    actionable_first: bool = True,
) -> List[AICIORankedDecision]:
    """
    Rank AI CIO decisions by risk-adjusted executive score.
    """

    scored: List[
        _Tuple[
            AICIODecision,
            Dict[str, Any],
        ]
    ] = []

    for decision in decisions:
        score = calculate_executive_score(
            decision,
            weights=weights,
        )

        scored.append(
            (
                decision,
                score,
            )
        )

    def sort_key(
        item: _Tuple[
            AICIODecision,
            Dict[str, Any],
        ]
    ) -> _Tuple[Any, ...]:
        decision, score = item

        actionable = bool(
            _decision_value(
                decision,
                "is_actionable",
                False,
            )
        )

        risk_veto = bool(
            _decision_value(
                decision,
                "risk_veto",
                False,
            )
        )

        confidence = _normalized_score_value(
            _decision_value(
                decision,
                "confidence",
                0.0,
            )
        )

        symbol = _normalize_symbol(
            _decision_value(
                decision,
                "symbol",
                "",
            )
        )

        return (
            0
            if not actionable_first
            else (-1 if actionable else 0),
            1 if risk_veto else 0,
            -score["executive_score"],
            -confidence,
            symbol,
        )

    scored.sort(
        key=sort_key
    )

    ranked: List[AICIORankedDecision] = []

    for rank, (
        decision,
        score,
    ) in enumerate(
        scored,
        start=1,
    ):
        ranked.append(
            AICIORankedDecision(
                rank=rank,
                symbol=_normalize_symbol(
                    _decision_value(
                        decision,
                        "symbol",
                        "",
                    )
                ),
                executive_score=score[
                    "executive_score"
                ],
                base_score=score[
                    "base_score"
                ],
                confidence_score=score[
                    "confidence_score"
                ],
                opportunity_score=score[
                    "opportunity_score"
                ],
                risk_adjustment=score[
                    "risk_adjustment"
                ],
                regime_adjustment=score[
                    "regime_adjustment"
                ],
                conviction_adjustment=score[
                    "conviction_adjustment"
                ],
                action_adjustment=score[
                    "action_adjustment"
                ],
                data_quality_score=score[
                    "data_quality_score"
                ],
                ranking_reasons=list(
                    score["ranking_reasons"]
                ),
                decision=decision,
            )
        )

    return ranked


def _derive_market_regime(
    ranked_decisions: Sequence[
        AICIORankedDecision
    ],
) -> str:
    regimes: Dict[str, int] = {}

    for item in ranked_decisions:
        regime = _normalize_market_regime(
            _decision_value(
                item.decision,
                "market_regime",
                "UNKNOWN",
            )
        )

        regimes[regime] = (
            regimes.get(regime, 0)
            + 1
        )

    if not regimes:
        return "UNKNOWN"

    return sorted(
        regimes.items(),
        key=lambda item: (
            -item[1],
            item[0],
        ),
    )[0][0]



def _deployment_posture(
    *,
    market_regime: str,
    average_score: float,
    veto_ratio: float,
    actionable_ratio: float,
) -> str:
    """
    Determine the portfolio deployment posture.

    High volatility has explicit defensive priority even where the market
    direction is not bearish.
    """
    normalized_regime = _normalize_market_regime(
        market_regime
    )

    if normalized_regime == "HIGH_VOLATILITY":
        return "DEFENSIVE"

    if (
        normalized_regime
        in {
            "STRONG_BULLISH",
            "BULLISH",
        }
        and average_score >= 70
        and veto_ratio <= 0.10
        and actionable_ratio >= 0.35
    ):
        return "AGGRESSIVE"

    if (
        normalized_regime
        in {
            "BEARISH",
            "STRONG_BEARISH",
        }
        or veto_ratio >= 0.30
        or average_score < 45
    ):
        return "DEFENSIVE"

    return "BALANCED"


def _recommended_exposure(
    *,
    posture: str,
    market_regime: str,
    average_score: float,
    actionable_ratio: float,
    veto_ratio: float,
) -> float:
    """
    Calculate risk-adjusted portfolio exposure with volatility controls.
    """
    normalized_regime = _normalize_market_regime(
        market_regime
    )

    base = {
        "AGGRESSIVE": 75.0,
        "BALANCED": 50.0,
        "DEFENSIVE": 25.0,
    }.get(posture, 40.0)

    score_delta = (
        average_score - 50.0
    ) * 0.35

    action_delta = (
        actionable_ratio - 0.25
    ) * 30.0

    veto_delta = -veto_ratio * 35.0

    regime_delta = {
        "STRONG_BULLISH": 10.0,
        "BULLISH": 5.0,
        "NEUTRAL": 0.0,
        "CAUTIOUS": -8.0,
        "BEARISH": -15.0,
        "STRONG_BEARISH": -25.0,

        "LOW_VOLATILITY": 4.0,
        "NORMAL_VOLATILITY": 0.0,
        "HIGH_VOLATILITY": -15.0,

        "UNKNOWN": -5.0,
    }.get(normalized_regime, -5.0)

    return round(
        _clamp(
            base
            + score_delta
            + action_delta
            + veto_delta
            + regime_delta,
            0.0,
            100.0,
        ),
        2,
    )


def _market_stance(
    market_regime: str,
    posture: str,
) -> str:
    """
    Produce an executive market stance that preserves volatility context.
    """
    normalized_regime = _normalize_market_regime(
        market_regime
    )

    if normalized_regime == "HIGH_VOLATILITY":
        return "VOLATILITY_DEFENSIVE"

    if posture == "AGGRESSIVE":
        return "RISK_ON"

    if posture == "DEFENSIVE":
        return "CAPITAL_PRESERVATION"

    if normalized_regime in {
        "BULLISH",
        "STRONG_BULLISH",
    }:
        return "SELECTIVE_RISK_ON"

    if normalized_regime in {
        "BEARISH",
        "STRONG_BEARISH",
        "CAUTIOUS",
    }:
        return "SELECTIVE_DEFENSIVE"

    if normalized_regime == "LOW_VOLATILITY":
        return "STABLE_SELECTIVE_DEPLOYMENT"

    return "NEUTRAL"

def build_ai_cio_summary(
    ranked_decisions: Sequence[
        AICIORankedDecision
    ],
) -> AICIOExecutiveSummary:
    """
    Generate an executive portfolio briefing.
    """

    total = len(ranked_decisions)

    action_counts = {
        "STRONG_BUY": 0,
        "BUY": 0,
        "HOLD": 0,
        "REDUCE": 0,
        "SELL": 0,
        "AVOID": 0,
    }

    risk_counts = {
        "APPROVED": 0,
        "APPROVED_WITH_CAUTION": 0,
        "VETOED": 0,
        "INSUFFICIENT_DATA": 0,
    }

    actionable = 0
    confidence_values: List[float] = []
    score_values: List[float] = []
    quality_values: List[float] = []
    requested_allocations: List[float] = []

    opportunities: List[str] = []
    warnings: List[str] = []

    for item in ranked_decisions:
        decision = item.decision

        action = _normalize_decision(
            _decision_value(
                decision,
                "decision",
                "HOLD",
            ),
            _decision_value(
                decision,
                "decision_score",
                50.0,
            ),
        )

        action_counts[action] = (
            action_counts.get(action, 0)
            + 1
        )

        risk_status = _upper(
            _decision_value(
                decision,
                "risk_status",
                "INSUFFICIENT_DATA",
            )
        )

        if risk_status not in risk_counts:
            risk_status = "INSUFFICIENT_DATA"

        risk_counts[risk_status] += 1

        is_actionable = bool(
            _decision_value(
                decision,
                "is_actionable",
                False,
            )
        )

        if is_actionable:
            actionable += 1

        confidence_values.append(
            _normalized_score_value(
                _decision_value(
                    decision,
                    "confidence",
                    0.0,
                )
            )
        )

        score_values.append(
            item.executive_score
        )

        quality_values.append(
            item.data_quality_score
        )

        allocation = _allocation_mapping(
            decision
        )

        position_size = max(
            0.0,
            _safe_float(
                allocation.get(
                    "position_size_pct",
                    0.0,
                )
            ),
        )

        requested_allocations.append(
            position_size
        )

        if (
            is_actionable
            and len(opportunities) < 5
        ):
            opportunities.append(
                item.symbol
            )

    average_confidence = round(
        sum(confidence_values)
        / len(confidence_values),
        2,
    ) if confidence_values else 0.0

    average_score = round(
        sum(score_values)
        / len(score_values),
        2,
    ) if score_values else 0.0

    average_quality = round(
        sum(quality_values)
        / len(quality_values),
        2,
    ) if quality_values else 0.0

    market_regime = _derive_market_regime(
        ranked_decisions
    )

    actionable_ratio = (
        actionable / total
        if total
        else 0.0
    )

    veto_ratio = (
        risk_counts["VETOED"] / total
        if total
        else 0.0
    )

    posture = _deployment_posture(
        market_regime=market_regime,
        average_score=average_score,
        veto_ratio=veto_ratio,
        actionable_ratio=actionable_ratio,
    )

    recommended_exposure = _recommended_exposure(
        posture=posture,
        market_regime=market_regime,
        average_score=average_score,
        actionable_ratio=actionable_ratio,
        veto_ratio=veto_ratio,
    )

    market_stance = _market_stance(
        market_regime,
        posture,
    )

    capital_requested = round(
        sum(requested_allocations),
        2,
    )

    capital_recommended = round(
        min(
            capital_requested,
            recommended_exposure,
        ),
        2,
    )

    concentration_warning = any(
        value > 20.0
        for value in requested_allocations
    )

    if capital_requested > 100.0:
        warnings.append(
            "Requested position sizes exceed 100% of portfolio capital"
        )

    if concentration_warning:
        warnings.append(
            "At least one recommended position exceeds 20% allocation"
        )

    if average_quality < 50.0 and total:
        warnings.append(
            "Average specialist-engine coverage is below 50%"
        )

    if risk_counts["VETOED"] > 0:
        warnings.append(
            f"{risk_counts['VETOED']} decision(s) are risk-vetoed"
        )

    if (
        risk_counts[
            "INSUFFICIENT_DATA"
        ] > 0
    ):
        warnings.append(
            f"{risk_counts['INSUFFICIENT_DATA']} decision(s) have insufficient risk data"
        )

    top_item = (
        ranked_decisions[0]
        if ranked_decisions
        else None
    )

    top_symbol = (
        top_item.symbol
        if top_item
        else None
    )

    top_decision = (
        _normalize_decision(
            _decision_value(
                top_item.decision,
                "decision",
                "HOLD",
            ),
            _decision_value(
                top_item.decision,
                "decision_score",
                50.0,
            ),
        )
        if top_item
        else None
    )

    top_score = (
        top_item.executive_score
        if top_item
        else 0.0
    )

    top_confidence = (
        _normalized_score_value(
            _decision_value(
                top_item.decision,
                "confidence",
                0.0,
            )
        )
        if top_item
        else 0.0
    )

    if total == 0:
        executive_message = (
            "No AI CIO decisions are currently available."
        )
    elif top_item:
        executive_message = (
            f"{posture.title()} deployment posture under a "
            f"{market_regime.replace('_', ' ').title()} market regime. "
            f"Top opportunity is {top_symbol} with an executive score "
            f"of {top_score:.2f}."
        )
    else:
        executive_message = (
            f"{posture.title()} deployment posture."
        )

    if risk_counts["VETOED"] > 0:
        risk_message = (
            f"Risk controls vetoed {risk_counts['VETOED']} "
            f"of {total} decisions. Vetoed opportunities must not receive capital."
        )
    elif risk_counts[
        "APPROVED_WITH_CAUTION"
    ] > 0:
        risk_message = (
            f"{risk_counts['APPROVED_WITH_CAUTION']} decision(s) "
            f"require cautious position sizing."
        )
    elif total:
        risk_message = (
            "No risk vetoes were detected in the ranked decision set."
        )
    else:
        risk_message = (
            "Risk status cannot be assessed without decisions."
        )

    return AICIOExecutiveSummary(
        generated_at=_datetime.now(
            _timezone.utc
        ).isoformat(),
        market_regime=market_regime,
        market_stance=market_stance,
        deployment_posture=posture,
        recommended_exposure_pct=recommended_exposure,

        total_decisions=total,
        actionable_decisions=actionable,

        strong_buy_count=action_counts[
            "STRONG_BUY"
        ],
        buy_count=action_counts["BUY"],
        hold_count=action_counts["HOLD"],
        reduce_count=action_counts["REDUCE"],
        sell_count=action_counts["SELL"],
        avoid_count=action_counts["AVOID"],

        approved_count=risk_counts[
            "APPROVED"
        ],
        caution_count=risk_counts[
            "APPROVED_WITH_CAUTION"
        ],
        vetoed_count=risk_counts[
            "VETOED"
        ],
        insufficient_risk_data_count=risk_counts[
            "INSUFFICIENT_DATA"
        ],

        average_confidence=average_confidence,
        average_executive_score=average_score,
        average_data_quality=average_quality,

        top_symbol=top_symbol,
        top_decision=top_decision,
        top_executive_score=top_score,
        top_confidence=top_confidence,

        capital_requested_pct=capital_requested,
        capital_recommended_pct=capital_recommended,
        concentration_warning=concentration_warning,

        executive_message=executive_message,
        risk_message=risk_message,
        opportunities=opportunities,
        warnings=warnings,
    )


def validate_ranked_ai_cio_output(
    ranked_decisions: Sequence[
        AICIORankedDecision
    ],
    *,
    raise_on_error: bool = False,
) -> Dict[str, Any]:
    """
    Validate ranking order, uniqueness, score boundaries and decision contracts.
    """

    errors: List[str] = []
    warnings: List[str] = []

    expected_rank = 1
    previous_score: Optional[float] = None
    symbols: set[str] = set()

    for item in ranked_decisions:
        if item.rank != expected_rank:
            errors.append(
                f"Expected rank {expected_rank}, received {item.rank}"
            )

        expected_rank += 1

        if not item.symbol:
            errors.append(
                f"Rank {item.rank} has no symbol"
            )

        if item.symbol in symbols:
            errors.append(
                f"Duplicate ranked symbol: {item.symbol}"
            )

        symbols.add(item.symbol)

        if not (
            0.0
            <= item.executive_score
            <= 100.0
        ):
            errors.append(
                f"{item.symbol}: executive score outside 0-100"
            )

        if not (
            0.0
            <= item.data_quality_score
            <= 100.0
        ):
            errors.append(
                f"{item.symbol}: data-quality score outside 0-100"
            )

        if (
            previous_score is not None
            and item.executive_score
            > previous_score
        ):
            warnings.append(
                f"{item.symbol}: score order increased after ranking"
            )

        previous_score = item.executive_score

        decision_symbol = _normalize_symbol(
            _decision_value(
                item.decision,
                "symbol",
                "",
            )
        )

        if decision_symbol != item.symbol:
            errors.append(
                f"{item.symbol}: ranked symbol differs from decision symbol"
            )

        try:
            validator = globals().get(
                "validate_ai_cio_decision"
            )

            if callable(validator):
                validator(item.decision)
        except Exception as exc:
            errors.append(
                f"{item.symbol}: contract validation failed: {exc}"
            )

        if bool(
            _decision_value(
                item.decision,
                "risk_veto",
                False,
            )
        ) and bool(
            _decision_value(
                item.decision,
                "is_actionable",
                False,
            )
        ):
            errors.append(
                f"{item.symbol}: risk-vetoed decision is actionable"
            )

    result = {
        "valid": not errors,
        "decision_count": len(
            ranked_decisions
        ),
        "error_count": len(errors),
        "warning_count": len(warnings),
        "errors": errors,
        "warnings": warnings,
    }

    if errors and raise_on_error:
        raise AICIOOrchestrationError(
            "AI CIO ranked-output validation failed: "
            + "; ".join(errors)
        )

    return result


def rank_ai_cio_result(
    source_result: AICIOBuildResult,
    *,
    weights: Optional[AICIORankingWeights] = None,
    actionable_first: bool = True,
    validate: bool = True,
    strict_validation: bool = False,
) -> AICIOExecutiveResult:
    """
    Convert Part 1 orchestration output into a complete executive result.
    """

    decisions = list(
        getattr(
            source_result,
            "decisions",
            [],
        )
    )

    ranked = rank_ai_cio_decisions(
        decisions,
        weights=weights,
        actionable_first=actionable_first,
    )

    summary = build_ai_cio_summary(
        ranked
    )

    validation = (
        validate_ranked_ai_cio_output(
            ranked,
            raise_on_error=strict_validation,
        )
        if validate
        else {
            "valid": True,
            "decision_count": len(ranked),
            "error_count": 0,
            "warning_count": 0,
            "errors": [],
            "warnings": [],
            "skipped": True,
        }
    )

    source_metadata = dict(
        getattr(
            source_result,
            "metadata",
            {},
        )
    )

    return AICIOExecutiveResult(
        ranked_decisions=ranked,
        summary=summary,
        validation=validation,
        source_result=source_result,
        metadata={
            **source_metadata,
            "phase": "12.2-part-2",
            "ranking_applied": True,
            "summary_generated": True,
            "validation_applied": validate,
            "repository_writes": False,
            "comparison_mode": False,
        },
    )


def build_ai_cio_executive_result(
    *,
    prediction_center: Any = None,
    investment_committee: Any = None,
    risk_engine: Any = None,
    portfolio_optimizer: Any = None,
    screener: Any = None,
    market_regime: Any = None,
    learning: Any = None,
    breadth: Any = None,
    metadata: Optional[MappingType] = None,
    strict: bool = False,
    weights: Optional[AICIORankingWeights] = None,
    actionable_first: bool = True,
    validate: bool = True,
    strict_validation: bool = False,
) -> AICIOExecutiveResult:
    """
    Build, rank, summarize and validate AI CIO decisions from raw engine output.
    """

    source_result = build_ai_cio_decisions(
        prediction_center=prediction_center,
        investment_committee=investment_committee,
        risk_engine=risk_engine,
        portfolio_optimizer=portfolio_optimizer,
        screener=screener,
        market_regime=market_regime,
        learning=learning,
        breadth=breadth,
        metadata=metadata,
        strict=strict,
    )

    return rank_ai_cio_result(
        source_result,
        weights=weights,
        actionable_first=actionable_first,
        validate=validate,
        strict_validation=strict_validation,
    )


def get_ai_cio(
    *,
    cache_key: str = "default",
    cache: Optional[AICIOCache] = None,
    ttl_seconds: float = 60.0,
    force_refresh: bool = False,
    prediction_center: Any = None,
    investment_committee: Any = None,
    risk_engine: Any = None,
    portfolio_optimizer: Any = None,
    screener: Any = None,
    market_regime: Any = None,
    learning: Any = None,
    breadth: Any = None,
    metadata: Optional[MappingType] = None,
    strict: bool = False,
    weights: Optional[AICIORankingWeights] = None,
    actionable_first: bool = True,
    validate: bool = True,
    strict_validation: bool = False,
) -> AICIOExecutiveResult:
    """
    Cached functional entry point.

    Phase 12.2 Part 2 accepts already-produced specialist-engine outputs.
    Production provider integration is added in Part 3.
    """

    selected_cache = (
        cache
        if cache is not None
        else _DEFAULT_AI_CIO_CACHE
    )

    normalized_key = (
        f"ai-cio:{str(cache_key or 'default').strip()}"
    )

    if not force_refresh:
        cached = selected_cache.get(
            normalized_key
        )

        if cached is not None:
            return cached

    result = build_ai_cio_executive_result(
        prediction_center=prediction_center,
        investment_committee=investment_committee,
        risk_engine=risk_engine,
        portfolio_optimizer=portfolio_optimizer,
        screener=screener,
        market_regime=market_regime,
        learning=learning,
        breadth=breadth,
        metadata=metadata,
        strict=strict,
        weights=weights,
        actionable_first=actionable_first,
        validate=validate,
        strict_validation=strict_validation,
    )

    selected_cache.set(
        normalized_key,
        result,
        ttl_seconds=ttl_seconds,
    )

    return result


def clear_ai_cio_cache(
    cache: Optional[AICIOCache] = None,
) -> None:
    selected_cache = (
        cache
        if cache is not None
        else _DEFAULT_AI_CIO_CACHE
    )

    selected_cache.clear()


def get_ai_cio_cache_stats(
    cache: Optional[AICIOCache] = None,
) -> Dict[str, Any]:
    selected_cache = (
        cache
        if cache is not None
        else _DEFAULT_AI_CIO_CACHE
    )

    return selected_cache.stats()


