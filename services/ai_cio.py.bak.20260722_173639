def _build_supporting_engines(
    *,
    prediction: MappingType,
    committee: MappingType,
    risk: MappingType,
    portfolio: MappingType,
    screener: MappingType,
    learning: MappingType,
    market_regime: MappingType,
    breadth: MappingType,
) -> Dict[str, Any]:
    return {
        "prediction_center": dict(prediction),
        "investment_committee": dict(committee),
        "risk_engine": dict(risk),
        "portfolio_optimizer": dict(portfolio),
        "screener_engine": dict(screener),
        "learning_engine": dict(learning),
        "market_regime_engine": dict(market_regime),
        "market_breadth": dict(breadth),
    }


def adapt_prediction_center(payload: Any) -> List[Dict[str, Any]]:
    return _as_records(
        payload,
        preferred_keys=(
            "predictions",
            "profiles",
            "opportunities",
        ),
    )


def adapt_investment_committee(payload: Any) -> List[Dict[str, Any]]:
    return _as_records(
        payload,
        preferred_keys=(
            "decisions",
            "committee_decisions",
            "recommendations",
        ),
    )


def adapt_risk_engine(payload: Any) -> List[Dict[str, Any]]:
    return _as_records(
        payload,
        preferred_keys=(
            "risk_metrics",
            "stocks",
            "rows",
        ),
    )


def adapt_portfolio_optimizer(payload: Any) -> List[Dict[str, Any]]:
    return _as_records(
        payload,
        preferred_keys=(
            "portfolio",
            "positions",
            "allocations",
            "holdings",
        ),
    )


def adapt_screener(payload: Any) -> List[Dict[str, Any]]:
    return _as_records(
        payload,
        preferred_keys=(
            "screener",
            "results",
            "stocks",
            "opportunities",
        ),
    )


def adapt_market_regime(payload: Any) -> Dict[str, Any]:
    if isinstance(payload, Mapping):
        source = dict(payload)

        nested = _first_mapping(
            source,
            (
                "market_regime",
                "regime",
                "result",
                "data",
            ),
        )

        if nested:
            return _merge_mappings(source, nested)

        return source

    return {}


def adapt_learning(payload: Any) -> Dict[str, Any]:
    if isinstance(payload, Mapping):
        source = dict(payload)

        nested = _first_mapping(
            source,
            (
                "learning",
                "summary",
                "metrics",
                "data",
            ),
        )

        if nested:
            return _merge_mappings(source, nested)

        return source

    return {}


def adapt_breadth(payload: Any) -> Dict[str, Any]:
    if isinstance(payload, Mapping):
        return dict(payload)

    return {}


def build_source_bundle(
    *,
    prediction_center: Any = None,
    investment_committee: Any = None,
    risk_engine: Any = None,
    portfolio_optimizer: Any = None,
    screener: Any = None,
    market_regime: Any = None,
    learning: Any = None,
    breadth: Any = None,
    metadata: Optional[MappingType] = None,
) -> AICIOSourceBundle:
    return AICIOSourceBundle(
        predictions=adapt_prediction_center(
            prediction_center
        ),
        committee=adapt_investment_committee(
            investment_committee
        ),
        risk=adapt_risk_engine(
            risk_engine
        ),
        portfolio=adapt_portfolio_optimizer(
            portfolio_optimizer
        ),
        screener=adapt_screener(
            screener
        ),
        market_regime=adapt_market_regime(
            market_regime
        ),
        learning=adapt_learning(
            learning
        ),
        breadth=adapt_breadth(
            breadth
        ),
        metadata=dict(metadata or {}),
    )


def _collect_symbols(
    bundle: AICIOSourceBundle,
) -> List[str]:
    """
    Preserve committee/prediction/screener ordering while avoiding duplicates.
    """

    ordered: List[str] = []

    for records in (
        bundle.committee,
        bundle.predictions,
        bundle.screener,
        bundle.risk,
        bundle.portfolio,
    ):
        for record in records:
            symbol = _normalize_symbol(
                _first_present(
                    record,
                    (
                        "symbol",
                        "ticker",
                        "code",
                        "security",
                        "instrument",
                    ),
                )
            )

            if symbol and symbol not in ordered:
                ordered.append(symbol)

    return ordered


def _decision_score(
    committee: MappingType,
    prediction: MappingType,
    screener: MappingType,
) -> float:
    for source, keys in (
        (
            committee,
            (
                "decision_score",
                "committee_score",
                "final_score",
                "score",
            ),
        ),
        (
            prediction,
            (
                "decision_score",
                "prediction_score",
                "forecast_score",
                "score",
            ),
        ),
        (
            screener,
            (
                "decision_score",
                "rank_score",
                "score",
            ),
        ),
    ):
        value = _first_present(source, keys)

        if value not in (None, ""):
            return _normalize_percentage(value)

    return 50.0


def _decision_confidence(
    committee: MappingType,
    prediction: MappingType,
    screener: MappingType,
) -> float:
    for source, keys in (
        (
            committee,
            (
                "confidence",
                "confidence_pct",
                "decision_confidence",
                "committee_confidence",
            ),
        ),
        (
            prediction,
            (
                "confidence",
                "confidence_pct",
                "prediction_confidence",
                "model_confidence",
            ),
        ),
        (
            screener,
            (
                "confidence",
                "confidence_pct",
            ),
        ),
    ):
        value = _first_present(source, keys)

        if value not in (None, ""):
            return _normalize_percentage(value)

    return 0.0



def _policy_first_score(
    sources: Sequence[MappingType],
    keys: Sequence[str],
) -> Optional[float]:
    """
    Find the first usable numeric score from normalized engine records.
    """

    for source in sources:
        if not isinstance(source, Mapping):
            continue

        value = _first_present(
            source,
            keys,
            None,
        )

        if value in (None, ""):
            continue

        return _normalize_percentage(value)

    return None


def _policy_mapping_score(
    source: MappingType,
    keys: Sequence[str],
) -> Optional[float]:
    """
    Find a score inside the existing AI CIO score breakdown.
    """

    for key in keys:
        if key not in source:
            continue

        value = source.get(key)

        if isinstance(value, Mapping):
            value = _first_present(
                value,
                (
                    "score",
                    "value",
                    "normalized_score",
                    "confidence",
                ),
                None,
            )

        if value in (None, ""):
            continue

        return _normalize_percentage(value)

    return None


def _build_ai_cio_policy_input(
    *,
    symbol: str,
    prediction: MappingType,
    committee: MappingType,
    risk: MappingType,
    portfolio: MappingType,
    screener: MappingType,
    learning: MappingType,
    regime: MappingType,
    breadth: MappingType,
    scores: MappingType,
    allocation: MappingType,
    risk_status: str,
    market_regime: str,
    metadata: MappingType,
) -> PolicyInput:
    """
    Adapt existing normalized AI CIO records into the Phase 12.4 policy input.

    This adapter is intentionally permissive because specialist engines may
    expose equivalent values under different field names.
    """

    prediction_score = (
        _policy_mapping_score(
            scores,
            (
                "prediction",
                "prediction_score",
                "forecast",
                "forecast_score",
                "model_score",
            ),
        )
        or _policy_first_score(
            (prediction,),
            (
                "prediction_score",
                "forecast_score",
                "model_score",
                "opportunity_score",
                "score",
                "confidence",
            ),
        )
    )

    committee_score = (
        _policy_mapping_score(
            scores,
            (
                "committee",
                "committee_score",
                "consensus",
                "consensus_score",
            ),
        )
        or _policy_first_score(
            (committee,),
            (
                "committee_score",
                "consensus_score",
                "committee_consensus",
                "agreement_pct",
                "score",
                "confidence",
            ),
        )
    )

    risk_score = (
        _policy_mapping_score(
            scores,
            (
                "risk",
                "risk_score",
                "safety",
                "safety_score",
            ),
        )
        or _policy_first_score(
            (risk, committee),
            (
                "risk_score",
                "safety_score",
                "risk_confidence",
                "score",
            ),
        )
    )

    portfolio_score = (
        _policy_mapping_score(
            scores,
            (
                "portfolio",
                "portfolio_score",
                "allocation",
                "allocation_score",
            ),
        )
        or _policy_first_score(
            (portfolio,),
            (
                "portfolio_score",
                "allocation_score",
                "fit_score",
                "suitability_score",
                "score",
            ),
        )
    )

    regime_score = (
        _policy_mapping_score(
            scores,
            (
                "market_regime",
                "regime",
                "regime_score",
            ),
        )
        or _policy_first_score(
            (regime,),
            (
                "market_regime_score",
                "regime_score",
                "confidence",
                "score",
            ),
        )
    )

    institutional_score = (
        _policy_mapping_score(
            scores,
            (
                "institutional",
                "institutional_flow",
                "volume",
                "volume_score",
                "liquidity",
            ),
        )
        or _policy_first_score(
            (screener, breadth, learning),
            (
                "institutional_score",
                "institutional_flow_score",
                "volume_score",
                "volume_intelligence_score",
                "accumulation_score",
                "liquidity_score",
            ),
        )
    )

    liquidity_score = _policy_first_score(
        (screener, breadth, prediction),
        (
            "liquidity_score",
            "volume_score",
            "volume_intelligence_score",
            "tradability_score",
            "marketability_score",
        ),
    )

    if liquidity_score is None:
        liquidity_score = institutional_score

    current_exposure = _policy_first_score(
        (allocation, portfolio),
        (
            "current_exposure_pct",
            "existing_exposure_pct",
            "portfolio_exposure_pct",
            "sector_exposure_pct",
            "current_weight_pct",
        ),
    )

    recommended_allocation = _policy_first_score(
        (allocation, portfolio, committee),
        (
            "recommended_allocation_pct",
            "allocation_pct",
            "target_weight_pct",
            "recommended_weight_pct",
            "position_size_pct",
        ),
    )

    data_age = _first_present(
        metadata,
        (
            "data_age_seconds",
            "market_data_age_seconds",
            "quote_age_seconds",
        ),
        None,
    )

    data_quality = _first_present(
        metadata,
        (
            "data_quality",
            "market_data_quality",
            "quality_status",
        ),
        "UNKNOWN",
    )

    return PolicyInput(
        symbol=symbol,
        prediction_score=prediction_score,
        committee_score=committee_score,
        risk_score=risk_score,
        portfolio_score=portfolio_score,
        market_regime_score=regime_score,
        institutional_score=institutional_score,
        risk_status=risk_status,
        market_regime=market_regime,
        liquidity_score=liquidity_score,
        current_exposure_pct=current_exposure,
        recommended_allocation_pct=recommended_allocation,
        data_age_seconds=data_age,
        data_quality=str(data_quality or "UNKNOWN"),
        metadata={
            "integration_phase": "12.4B-shadow",
        },
    )


def assemble_ai_cio_decision(
    *,
    symbol: str,
    prediction: Optional[MappingType] = None,
    committee: Optional[MappingType] = None,
    risk: Optional[MappingType] = None,
    portfolio: Optional[MappingType] = None,
    screener: Optional[MappingType] = None,
    learning: Optional[MappingType] = None,
    market_regime: Optional[MappingType] = None,
    breadth: Optional[MappingType] = None,
    metadata: Optional[MappingType] = None,
) -> AICIODecisionAssembly:
    """
    Assemble and validate one AI CIO decision from specialist-engine records.
    """

    normalized_symbol = _normalize_symbol(symbol)

    if not normalized_symbol:
        raise AICIOOrchestrationError(
            "Cannot assemble AI CIO decision without a symbol"
        )

    prediction_record = dict(prediction or {})
    committee_record = dict(committee or {})
    risk_record = dict(risk or {})
    portfolio_record = dict(portfolio or {})
    screener_record = dict(screener or {})
    learning_record = dict(learning or {})
    regime_record = dict(market_regime or {})
    breadth_record = dict(breadth or {})
    source_metadata = dict(metadata or {})

    warnings: List[str] = []

    if not committee_record:
        warnings.append(
            "Investment committee record unavailable"
        )

    if not prediction_record:
        warnings.append(
            "Prediction-center record unavailable"
        )

    if not risk_record:
        warnings.append(
            "Symbol risk record unavailable"
        )

    decision_score = _decision_score(
        committee_record,
        prediction_record,
        screener_record,
    )

    confidence = _decision_confidence(
        committee_record,
        prediction_record,
        screener_record,
    )

    decision_value = _normalize_decision(
        _first_present(
            committee_record,
            (
                "decision",
                "final_decision",
                "recommendation",
                "signal",
                "action",
            ),
            _first_present(
                prediction_record,
                (
                    "decision",
                    "recommendation",
                    "signal",
                    "action",
                ),
                _first_present(
                    screener_record,
                    (
                        "decision",
                        "signal",
                        "recommendation",
                    ),
                ),
            ),
        ),
        decision_score,
    )

    risk_veto = bool(
        _first_present(
            risk_record,
            (
                "risk_veto",
                "veto",
                "blocked",
                "is_blocked",
            ),
            _first_present(
                committee_record,
                (
                    "risk_veto",
                    "veto",
                    "blocked",
                ),
                False,
            ),
        )
    )

    risk_status = _normalize_risk_status(
        _merge_mappings(
            committee_record,
            risk_record,
            {"risk_veto": risk_veto},
        )
    )

    committee_consensus = _normalize_percentage(
        _first_present(
            committee_record,
            (
                "committee_consensus",
                "consensus_score",
                "consensus",
                "agreement_pct",
                "agreement",
            ),
            0.0,
        )
    )

    committee_agreement = _normalize_percentage(
        _first_present(
            committee_record,
            (
                "committee_agreement",
                "agreement_pct",
                "agreement",
                "agreeing_pct",
            ),
            committee_consensus,
        )
    )

    committee_disagreement = _normalize_percentage(
        _first_present(
            committee_record,
            (
                "committee_disagreement",
                "disagreement_pct",
                "disagreement",
                "conflict_pct",
            ),
            max(0.0, 100.0 - committee_agreement)
            if committee_agreement > 0
            else 0.0,
        )
    )

    scores = _extract_scores(
        prediction_record,
        committee_record,
        risk_record,
        screener_record,
        learning_record,
        regime_record,
    )

    price_plan = _extract_price_plan(
        prediction_record,
        committee_record,
        screener_record,
    )

    allocation = _extract_allocation(
        portfolio_record,
        committee_record,
        screener_record,
    )

    normalized_market_regime = _normalize_market_regime(
        regime_record
    )

    policy_result = None

    try:
        policy_input = _build_ai_cio_policy_input(
            symbol=normalized_symbol,
            prediction=prediction_record,
            committee=committee_record,
            risk=risk_record,
            portfolio=portfolio_record,
            screener=screener_record,
            learning=learning_record,
            regime=regime_record,
            breadth=breadth_record,
            scores=scores,
            allocation=allocation,
            risk_status=risk_status,
            market_regime=normalized_market_regime,
            metadata=source_metadata,
        )

        policy_result = evaluate_ai_cio_policy(
            policy_input
        )

        if policy_result.decision != decision_value:
            warnings.append(
                "AI CIO policy shadow decision differs from "
                f"current orchestration: "
                f"{decision_value} -> {policy_result.decision}"
            )

        for policy_warning in policy_result.warnings:
            warning_text = (
                f"AI CIO policy shadow: {policy_warning}"
            )

            if warning_text not in warnings:
                warnings.append(warning_text)

    except Exception as exc:
        warnings.append(
            f"AI CIO policy shadow evaluation failed: {exc}"
        )


    why_now = _extract_reasons(
        committee_record,
        prediction_record,
        screener_record,
        keys=(
            "why_now",
            "reasons",
            "reason",
            "supporting_reasons",
            "bullish_reasons",
            "decision_reasons",
            "explanation",
        ),
    )

    key_risks = _extract_reasons(
        risk_record,
        committee_record,
        prediction_record,
        keys=(
            "key_risks",
            "risk_factors",
            "risks",
            "warnings",
            "risk_reasons",
        ),
    )

    invalidation_conditions = _extract_reasons(
        committee_record,
        prediction_record,
        risk_record,
        keys=(
            "invalidation_conditions",
            "invalidation",
            "exit_conditions",
            "failure_conditions",
            "stop_conditions",
        ),
    )

    ranking_reasons = _extract_reasons(
        committee_record,
        prediction_record,
        screener_record,
        keys=(
            "ranking_reasons",
            "rank_reasons",
            "selection_reasons",
            "opportunity_reasons",
        ),
    )

    supporting_engines = _build_supporting_engines(
        prediction=prediction_record,
        committee=committee_record,
        risk=risk_record,
        portfolio=portfolio_record,
        screener=screener_record,
        learning=learning_record,
        market_regime=regime_record,
        breadth=breadth_record,
    )

    contract_payload = {
        "symbol": normalized_symbol,
        "decision": decision_value,
        "decision_score": decision_score,
        "confidence": confidence,
        "conviction": _normalize_conviction(
            _first_present(
                committee_record,
                (
                    "conviction",
                    "conviction_level",
                    "confidence_level",
                    "rating",
                ),
                _first_present(
                    prediction_record,
                    (
                        "conviction",
                        "confidence_level",
                        "rating",
                    ),
                ),
            ),
            confidence,
        ),
        "market_regime": normalized_market_regime,
        "risk_status": risk_status,
        "risk_veto": risk_veto,
        "committee_consensus": committee_consensus,
        "committee_agreement": committee_agreement,
        "committee_disagreement": committee_disagreement,
        "scores": scores,
        "price_plan": price_plan,
        "allocation": allocation,
        "why_now": why_now,
        "key_risks": key_risks,
        "invalidation_conditions": invalidation_conditions,
        "ranking_reasons": ranking_reasons,
        "supporting_engines": supporting_engines,
        "source_metadata": {
            **source_metadata,
            "phase": "12.2-part-1",
            "orchestrator": "services.ai_cio",
            "policy_shadow": (
                policy_result.to_dict()
                if policy_result is not None
                else None
            ),
            "policy_shadow_enabled": True,
            "policy_shadow_phase": "12.4B",
            "available_sources": {
                "prediction_center": bool(prediction_record),
                "investment_committee": bool(committee_record),
                "risk_engine": bool(risk_record),
                "portfolio_optimizer": bool(portfolio_record),
                "screener_engine": bool(screener_record),
                "learning_engine": bool(learning_record),
                "market_regime_engine": bool(regime_record),
                "market_breadth": bool(breadth_record),
            },
        },
    }

    try:
        decision = build_ai_cio_decision(
            contract_payload
        )
    except DecisionContractError as exc:
        raise AICIOOrchestrationError(
            f"{normalized_symbol}: AI CIO contract validation failed: {exc}"
        ) from exc

    return AICIODecisionAssembly(
        symbol=normalized_symbol,
        decision=decision,
        warnings=warnings,
    )


def build_ai_cio_from_bundle(
    bundle: AICIOSourceBundle,
    *,
    strict: bool = False,
) -> AICIOBuildResult:
    """
    Assemble one validated decision per available symbol.

    strict=False:
        Invalid symbols are recorded in `errors`; valid symbols continue.

    strict=True:
        First assembly error is raised immediately.
    """

    prediction_index = _index_records(
        bundle.predictions
    )
    committee_index = _index_records(
        bundle.committee
    )
    risk_index = _index_records(
        bundle.risk
    )
    portfolio_index = _index_records(
        bundle.portfolio
    )
    screener_index = _index_records(
        bundle.screener
    )

    symbols = _collect_symbols(bundle)

    assemblies: List[AICIODecisionAssembly] = []
    errors: List[Dict[str, Any]] = []

    for symbol in symbols:
        try:
            assembly = assemble_ai_cio_decision(
                symbol=symbol,
                prediction=prediction_index.get(symbol),
                committee=committee_index.get(symbol),
                risk=risk_index.get(symbol),
                portfolio=portfolio_index.get(symbol),
                screener=screener_index.get(symbol),
                learning=bundle.learning,
                market_regime=bundle.market_regime,
                breadth=bundle.breadth,
                metadata=bundle.metadata,
            )

            assemblies.append(assembly)

        except Exception as exc:
            error = {
                "symbol": symbol,
                "error_type": type(exc).__name__,
                "message": str(exc),
            }

            errors.append(error)

            if strict:
                raise

    return AICIOBuildResult(
        decisions=[
            assembly.decision
            for assembly in assemblies
        ],
        assemblies=assemblies,
        errors=errors,
        source_counts={
            "predictions": len(bundle.predictions),
            "committee": len(bundle.committee),
            "risk": len(bundle.risk),
            "portfolio": len(bundle.portfolio),
            "screener": len(bundle.screener),
            "symbols": len(symbols),
            "decisions": len(assemblies),
            "errors": len(errors),
        },
        metadata={
            **bundle.metadata,
            "phase": "12.2-part-1",
            "ranking_applied": False,
            "summary_generated": False,
            "cache_applied": False,
            "repository_writes": False,
        },
    )


class AICIOOrchestrator:
    """
    Dependency-injected Phase 12.2 core orchestrator.

    Providers may be actual engine functions or test doubles. This avoids
    importing or invoking production engines during unit tests.
    """

    def __init__(
        self,
        *,
        prediction_provider: Optional[Provider] = None,
        committee_provider: Optional[Provider] = None,
        risk_provider: Optional[Provider] = None,
        portfolio_provider: Optional[Provider] = None,
        screener_provider: Optional[Provider] = None,
        market_regime_provider: Optional[Provider] = None,
        learning_provider: Optional[Provider] = None,
        breadth_provider: Optional[Provider] = None,
        metadata: Optional[MappingType] = None,
    ) -> None:
        self._prediction_provider = prediction_provider
        self._committee_provider = committee_provider
        self._risk_provider = risk_provider
        self._portfolio_provider = portfolio_provider
        self._screener_provider = screener_provider
        self._market_regime_provider = market_regime_provider
        self._learning_provider = learning_provider
        self._breadth_provider = breadth_provider
        self._metadata = dict(metadata or {})

    @staticmethod
    def _call_provider(
        provider: Optional[Provider],
        source_name: str,
    ) -> Any:
        if provider is None:
            return None

        try:
            return provider()
        except Exception as exc:
            raise AICIOOrchestrationError(
                f"{source_name} provider failed: {exc}"
            ) from exc

    def collect_sources(self) -> AICIOSourceBundle:
        return build_source_bundle(
            prediction_center=self._call_provider(
                self._prediction_provider,
                "prediction_center",
            ),
            investment_committee=self._call_provider(
                self._committee_provider,
                "investment_committee",
            ),
            risk_engine=self._call_provider(
                self._risk_provider,
                "risk_engine",
            ),
            portfolio_optimizer=self._call_provider(
                self._portfolio_provider,
                "portfolio_optimizer",
            ),
            screener=self._call_provider(
                self._screener_provider,
                "screener_engine",
            ),
            market_regime=self._call_provider(
                self._market_regime_provider,
                "market_regime_engine",
            ),
            learning=self._call_provider(
                self._learning_provider,
                "learning_engine",
            ),
            breadth=self._call_provider(
                self._breadth_provider,
                "market_breadth",
            ),
            metadata=self._metadata,
        )

    def build(
        self,
        *,
        strict: bool = False,
    ) -> AICIOBuildResult:
        return build_ai_cio_from_bundle(
            self.collect_sources(),
            strict=strict,
        )


