def _extract_committee_agent_scores(
    committee: MappingType,
) -> Dict[str, float]:
    """
    Extract normalized specialist scores from nested committee agents.

    Supports agent collections exposed under common keys such as:
    agents, members, committee_members, votes and agent_results.
    """
    agent_candidates = _first_list(
        committee,
        (
            "agents",
            "members",
            "committee_members",
            "votes",
            "agent_results",
            "analysts",
        ),
    )

    # Some producers may wrap the list inside another mapping.
    if not agent_candidates:
        for container_key in (
            "committee",
            "investment_committee",
            "committee_result",
            "result",
            "data",
        ):
            container = committee.get(container_key)

            if isinstance(container, Mapping):
                agent_candidates = _first_list(
                    container,
                    (
                        "agents",
                        "members",
                        "committee_members",
                        "votes",
                        "agent_results",
                        "analysts",
                    ),
                )

                if agent_candidates:
                    break

    extracted: Dict[str, float] = {}

    for item in agent_candidates:
        if not isinstance(item, Mapping):
            continue

        name = str(item.get("name") or "").strip().upper()
        role = str(item.get("role") or "").strip().upper()
        identity = f"{name} {role}"

        score = _normalize_percentage(
            _first_present(
                item,
                (
                    "score",
                    "agent_score",
                    "confidence_score",
                    "strength_score",
                    "confidence",
                ),
                0.0,
            ),
            0.0,
        )

        if (
            "TECHNICAL" in identity
            and "technical" not in extracted
        ):
            extracted["technical"] = score

        elif (
            any(
                token in identity
                for token in (
                    "INSTITUTIONAL",
                    "FLOW ANALYST",
                    "SMART MONEY",
                )
            )
            and "institutional" not in extracted
        ):
            extracted["institutional"] = score

        elif (
            "VOLUME" in identity
            and "volume" not in extracted
        ):
            extracted["volume"] = score

        elif (
            "RISK" in identity
            and "risk" not in extracted
        ):
            extracted["risk"] = score

        elif (
            any(
                token in identity
                for token in (
                    "PORTFOLIO",
                    "ALLOCATION",
                )
            )
            and "portfolio_fit" not in extracted
        ):
            extracted["portfolio_fit"] = score

        elif (
            any(
                token in identity
                for token in (
                    "LEARNING",
                    "ADAPTIVE",
                )
            )
            and "learning" not in extracted
        ):
            extracted["learning"] = score

        elif (
            any(
                token in identity
                for token in (
                    "QUANT",
                    "PREDICTIVE",
                    "PREDICTION",
                )
            )
            and "prediction" not in extracted
        ):
            extracted["prediction"] = score

    return extracted


def _extract_scores(
    prediction: MappingType,
    committee: MappingType,
    risk: MappingType,
    screener: MappingType,
    learning: MappingType,
    market_regime: MappingType,
) -> Dict[str, float]:
    prediction_scores = _first_mapping(
        prediction,
        ("scores", "score_breakdown", "components"),
    )
    committee_scores = _first_mapping(
        committee,
        ("scores", "score_breakdown", "components"),
    )
    screener_scores = _first_mapping(
        screener,
        ("scores", "score_breakdown", "components"),
    )

    committee_agent_scores = _extract_committee_agent_scores(
        committee,
    )

    return {
        "technical": _source_score(
            _merge_mappings(
                screener_scores,
                committee_scores,
                screener,
                committee,
                committee_agent_scores,
            ),
            (
                "technical",
                "technical_score",
                "technical_strength",
                "ta_score",
            ),
        ),
        "volume": _source_score(
            _merge_mappings(
                screener_scores,
                committee_scores,
                screener,
                committee,
                committee_agent_scores,
            ),
            (
                "volume",
                "volume_score",
                "volume_strength",
                "volume_quality",
            ),
        ),
        "institutional": _source_score(
            _merge_mappings(
                committee_scores,
                committee,
                committee_agent_scores,
            ),
            (
                "institutional",
                "institutional_score",
                "institutional_strength_index",
                "flow_score",
            ),
        ),
        "prediction": _source_score(
            _merge_mappings(
                prediction_scores,
                prediction,
            ),
            (
                "prediction_probability_pct",
                "conviction_score",
                "regime_adjusted_conviction_score",
                "raw_conviction_score",
                "confidence",
                "prediction",
                "prediction_score",
                "forecast_score",
                "model_score",
                "probability_success_pct",
                "score",
            ),
        ),
        "committee": _source_score(
            _merge_mappings(
                committee_scores,
                committee,
            ),
            (
                "committee",
                "committee_score",
                "decision_score",
                "score",
            ),
        ),
        "consensus": _source_score(
            committee,
            (
                "consensus_score",
                "committee_consensus",
                "agreement_pct",
                "agreement",
