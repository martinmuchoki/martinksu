def _decision_payload(
    decision: AICIODecision,
) -> Dict[str, Any]:
    if hasattr(decision, "to_dict"):
        value = decision.to_dict()

        if isinstance(value, Mapping):
            return dict(value)

    try:
        value = _dataclass_asdict(decision)

        if isinstance(value, Mapping):
            return dict(value)
    except (TypeError, ValueError):
        pass

    return {
        key: getattr(decision, key)
        for key in dir(decision)
        if not key.startswith("_")
        and not callable(getattr(decision, key))
    }


def _decision_value(
    decision: AICIODecision,
    key: str,
    default: Any = None,
) -> Any:
    if hasattr(decision, key):
        value = getattr(decision, key)

        if value is not None:
            return value

    return _decision_payload(decision).get(
        key,
        default,
    )


def _score_mapping(
