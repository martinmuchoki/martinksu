    normalized = _normalize_decision(
        decision_value,
        50.0,
    )

    adjustments = {
        "STRONG_BUY": 5.0,
        "BUY": 3.0,
        "HOLD": 0.0,
        "REDUCE": -4.0,
        "SELL": -7.0,
