@dataclass(frozen=True)
class AICIORankingWeights:
    """
    Executive ranking weights.

    The weights are normalized automatically, so callers may provide either
    decimal proportions or whole-number percentages.
    """

    committee: float = 0.24
    prediction: float = 0.18
    technical: float = 0.14
    institutional: float = 0.10
    volume: float = 0.10
    consensus: float = 0.08
    market_regime: float = 0.06
    learning: float = 0.05
    portfolio_fit: float = 0.03
    risk: float = 0.02

    def normalized(self) -> Dict[str, float]:
        raw = {
            "committee": max(0.0, _safe_float(self.committee)),
            "prediction": max(0.0, _safe_float(self.prediction)),
            "technical": max(0.0, _safe_float(self.technical)),
            "institutional": max(0.0, _safe_float(self.institutional)),
            "volume": max(0.0, _safe_float(self.volume)),
            "consensus": max(0.0, _safe_float(self.consensus)),
            "market_regime": max(0.0, _safe_float(self.market_regime)),
            "learning": max(0.0, _safe_float(self.learning)),
            "portfolio_fit": max(0.0, _safe_float(self.portfolio_fit)),
            "risk": max(0.0, _safe_float(self.risk)),
        }

        total = sum(raw.values())

        if total <= 0:
            raise AICIOOrchestrationError(
                "AI CIO ranking weights must have a positive total"
            )

        return {
            key: value / total
            for key, value in raw.items()
        }


