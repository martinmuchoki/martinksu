def _safe_float(value: Any, default: float = 0.0) -> float:
    if value in (None, ""):
        return float(default)

    try:
        result = float(value)
    except (TypeError, ValueError):
        return float(default)

    if result != result:
        return float(default)

    if result in (float("inf"), float("-inf")):
        return float(default)

    return result


def _safe_int(value: Any, default: int = 0) -> int:
    if value in (None, ""):
        return int(default)

    try:
        return int(float(value))
    except (TypeError, ValueError):
        return int(default)


def _clamp(value: Any, minimum: float, maximum: float) -> float:
    return max(minimum, min(maximum, _safe_float(value)))


def _normalize_symbol(value: Any) -> str:
    return str(value or "").strip().upper()


def _upper(value: Any, default: str = "") -> str:
    text = str(value or default).strip().upper()
    return text.replace(" ", "_").replace("-", "_")


def _first_present(
    source: MappingType,
    keys: Sequence[str],
    default: Any = None,
) -> Any:
    for key in keys:
        if key in source and source.get(key) not in (None, ""):
            return source.get(key)

    return default


def _first_mapping(
    source: MappingType,
    keys: Sequence[str],
) -> Dict[str, Any]:
    for key in keys:
        value = source.get(key)

        if isinstance(value, Mapping):
            return dict(value)

    return {}


def _first_list(
    source: MappingType,
    keys: Sequence[str],
) -> List[Any]:
    for key in keys:
        value = source.get(key)

        if isinstance(value, list):
            return list(value)

        if isinstance(value, tuple):
            return list(value)

    return []


def _merge_mappings(*sources: MappingType) -> Dict[str, Any]:
    merged: Dict[str, Any] = {}

    for source in sources:
        if isinstance(source, Mapping):
            merged.update(dict(source))

    return merged


def _as_mapping(value: Any) -> Dict[str, Any]:
    if isinstance(value, Mapping):
        return dict(value)

    return {}


def _as_records(
    payload: Any,
    *,
    preferred_keys: Sequence[str] = (),
) -> List[Dict[str, Any]]:
    """
    Convert common specialist-engine payload shapes into a record list.

    Supported shapes:
    - list[dict]
    - tuple[dict]
    - {"rows": [...]}
    - {"results": [...]}
    - {"decisions": [...]}
    - {"predictions": [...]}
    - {"stocks": [...]}
    - {"data": [...]}
    - {"SYMBOL": {...}, ...}
    """

    if payload is None:
        return []

    if isinstance(payload, (list, tuple)):
        return [
            dict(item)
            for item in payload
            if isinstance(item, Mapping)
        ]

    if not isinstance(payload, Mapping):
        return []

    source = dict(payload)

    keys = list(preferred_keys) + [
        "rows",
        "results",
        "items",
        "data",
        "stocks",
        "signals",
        "decisions",
        "predictions",
        "opportunities",
        "profiles",
        "portfolio",
        "holdings",
        "risk_metrics",
    ]

    for key in keys:
        value = source.get(key)

        if isinstance(value, (list, tuple)):
            return [
                dict(item)
                for item in value
                if isinstance(item, Mapping)
            ]

    records: List[Dict[str, Any]] = []

    for key, value in source.items():
        if not isinstance(value, Mapping):
            continue

        record = dict(value)

        if not _normalize_symbol(
            _first_present(
                record,
                (
                    "symbol",
                    "ticker",
                    "code",
                    "security",
                ),
            )
        ):
            record["symbol"] = _normalize_symbol(key)

        records.append(record)

    return records


def _index_records(
    records: Iterable[MappingType],
) -> Dict[str, Dict[str, Any]]:
    indexed: Dict[str, Dict[str, Any]] = {}

    for raw_record in records:
        record = dict(raw_record)

        symbol = _normalize_symbol(
            _first_present(
                record,
                (
                    "symbol",
                    "ticker",
                    "code",
                    "security",
                    "instrument",
                ),
            )
        )

        if not symbol:
            continue

        if symbol in indexed:
            indexed[symbol] = _merge_mappings(
                indexed[symbol],
                record,
            )
        else:
            record["symbol"] = symbol
            indexed[symbol] = record

    return indexed


def _normalize_percentage(
    value: Any,
    default: float = 0.0,
) -> float:
    numeric = _safe_float(value, default)

    if 0.0 <= numeric <= 1.0:
        numeric *= 100.0

    return round(_clamp(numeric, 0.0, 100.0), 2)


def _normalize_decision(
    value: Any,
    score: Any = 0.0,
) -> str:
    raw = _upper(value)

    aliases = {
        "STRONGBUY": "STRONG_BUY",
        "ACCUMULATE": "BUY",
        "LONG": "BUY",
        "POSITIVE": "BUY",
        "NEUTRAL": "HOLD",
        "WAIT": "HOLD",
        "WATCH": "HOLD",
        "NO_ACTION": "HOLD",
        "UNDERWEIGHT": "REDUCE",
        "TAKE_PROFIT": "REDUCE",
        "EXIT": "SELL",
        "SHORT": "SELL",
        "NEGATIVE": "SELL",
        "REJECT": "AVOID",
        "BLOCK": "AVOID",
        "BLOCKED": "AVOID",
    }

    raw = aliases.get(raw, raw)

    allowed = {
        "STRONG_BUY",
        "BUY",
        "HOLD",
        "REDUCE",
        "SELL",
        "AVOID",
    }

    if raw in allowed:
        return raw

    numeric_score = _safe_float(score, 50.0)

    if numeric_score >= 85:
        return "STRONG_BUY"

    if numeric_score >= 65:
        return "BUY"

    if numeric_score >= 45:
        return "HOLD"

    if numeric_score >= 30:
        return "REDUCE"

    return "SELL"


def _normalize_conviction(
    value: Any,
    confidence: Any,
) -> str:
    raw = _upper(value)

    aliases = {
        "VERYHIGH": "VERY_HIGH",
        "STRONG": "HIGH",
        "MODERATE": "MEDIUM",
        "AVERAGE": "MEDIUM",
        "WEAK": "LOW",
        "VERYLOW": "VERY_LOW",
    }

    raw = aliases.get(raw, raw)

    allowed = {
        "VERY_HIGH",
        "HIGH",
        "MEDIUM",
        "LOW",
        "VERY_LOW",
    }

    if raw in allowed:
        return raw

    normalized_confidence = _normalize_percentage(confidence)

    if normalized_confidence >= 90:
        return "VERY_HIGH"

    if normalized_confidence >= 75:
        return "HIGH"

    if normalized_confidence >= 55:
        return "MEDIUM"

    if normalized_confidence >= 35:
        return "LOW"

    return "VERY_LOW"



def _normalize_market_regime(value: Any) -> str:
    """
    Normalize directional and volatility-based market regimes.

    Volatility regimes are preserved as first-class AI CIO regimes instead
    of being converted to UNKNOWN.
    """
    if isinstance(value, Mapping):
        value = _first_present(
            value,
            (
                "regime",
                "market_regime",
                "normalized_regime",
                "regime_name",
                "classification",
                "label",
                "status",
                "name",
                "volatility_regime",
            ),
            "UNKNOWN",
        )

    raw = _upper(value, "UNKNOWN")

    aliases = {
        # Directional regimes
        "STRONGBULLISH": "STRONG_BULLISH",
        "STRONG_BULL": "STRONG_BULLISH",
        "BULL": "BULLISH",
        "BULL_MARKET": "BULLISH",
        "POSITIVE": "BULLISH",
        "RISK_ON": "BULLISH",

        "SIDEWAYS": "NEUTRAL",
        "RANGE": "NEUTRAL",
        "RANGE_BOUND": "NEUTRAL",
        "MIXED": "NEUTRAL",
        "NORMAL": "NEUTRAL",

        "DEFENSIVE": "CAUTIOUS",
        "RISK_OFF": "CAUTIOUS",

        "BEAR": "BEARISH",
        "BEAR_MARKET": "BEARISH",
        "NEGATIVE": "BEARISH",
        "STRONGBEARISH": "STRONG_BEARISH",
        "STRONG_BEAR": "STRONG_BEARISH",

        # Volatility regimes
        "VOLATILE": "HIGH_VOLATILITY",
        "HIGH_VOL": "HIGH_VOLATILITY",
        "HIGHVOLATILITY": "HIGH_VOLATILITY",
        "VERY_HIGH_VOLATILITY": "HIGH_VOLATILITY",
        "EXTREME_VOLATILITY": "HIGH_VOLATILITY",
        "ELEVATED_VOLATILITY": "HIGH_VOLATILITY",
        "TURBULENT": "HIGH_VOLATILITY",

        "LOW_VOL": "LOW_VOLATILITY",
        "LOWVOLATILITY": "LOW_VOLATILITY",
        "VERY_LOW_VOLATILITY": "LOW_VOLATILITY",
        "CALM": "LOW_VOLATILITY",
        "STABLE": "LOW_VOLATILITY",
        "QUIET": "LOW_VOLATILITY",

        "MEDIUM_VOLATILITY": "NORMAL_VOLATILITY",
        "MODERATE_VOLATILITY": "NORMAL_VOLATILITY",
        "AVERAGE_VOLATILITY": "NORMAL_VOLATILITY",
        "NORMALVOLATILITY": "NORMAL_VOLATILITY",
    }

    raw = aliases.get(raw, raw)

    allowed = {
        "STRONG_BULLISH",
        "BULLISH",
        "NEUTRAL",
        "CAUTIOUS",
        "BEARISH",
        "STRONG_BEARISH",
        "HIGH_VOLATILITY",
        "NORMAL_VOLATILITY",
        "LOW_VOLATILITY",
        "UNKNOWN",
    }

    return raw if raw in allowed else "UNKNOWN"

def _normalize_risk_status(
    risk_record: MappingType,
) -> str:
    veto = bool(
        _first_present(
            risk_record,
            (
                "risk_veto",
                "veto",
                "blocked",
                "is_blocked",
            ),
            False,
        )
    )

    if veto:
        return "VETOED"

    raw = _upper(
        _first_present(
            risk_record,
            (
                "risk_status",
                "approval_status",
                "status",
                "decision",
            ),
        )
    )

    aliases = {
        "PASS": "APPROVED",
        "OK": "APPROVED",
        "SAFE": "APPROVED",
        "LOW": "APPROVED",
        "MEDIUM": "APPROVED_WITH_CAUTION",
        "MODERATE": "APPROVED_WITH_CAUTION",
        "CAUTION": "APPROVED_WITH_CAUTION",
        "HIGH": "APPROVED_WITH_CAUTION",
        "FAIL": "VETOED",
        "BLOCK": "VETOED",
        "BLOCKED": "VETOED",
        "REJECTED": "VETOED",
        "UNKNOWN": "INSUFFICIENT_DATA",
    }

    raw = aliases.get(raw, raw)

    allowed = {
        "APPROVED",
        "APPROVED_WITH_CAUTION",
        "VETOED",
        "INSUFFICIENT_DATA",
    }

    if raw in allowed:
        return raw

    risk_score = _safe_float(
        _first_present(
            risk_record,
            (
                "risk_score",
                "score",
                "safety_score",
            ),
            0.0,
        )
    )

    if risk_score <= 0:
        return "INSUFFICIENT_DATA"

    if risk_score >= 70:
        return "APPROVED"

    if risk_score >= 40:
        return "APPROVED_WITH_CAUTION"

    return "VETOED"


def _extract_reasons(
    *sources: MappingType,
    keys: Sequence[str],
) -> List[str]:
    reasons: List[str] = []

    for source in sources:
        for key in keys:
            value = source.get(key)

            if isinstance(value, str):
                text = value.strip()

                if text and text not in reasons:
                    reasons.append(text)

            elif isinstance(value, (list, tuple)):
                for item in value:
                    text = str(item or "").strip()

                    if text and text not in reasons:
                        reasons.append(text)

    return reasons[:20]


def _source_score(
    source: MappingType,
    keys: Sequence[str],
    default: float = 0.0,
) -> float:
    return _normalize_percentage(
        _first_present(
            source,
            keys,
            default,
        ),
        default,
    )


def _extract_price_plan(
    prediction: MappingType,
    committee: MappingType,
    screener: MappingType,
) -> Dict[str, Any]:
    nested = _merge_mappings(
        _first_mapping(
            prediction,
            ("price_plan", "trade_plan", "levels"),
        ),
        _first_mapping(
            committee,
            ("price_plan", "trade_plan", "levels"),
        ),
    )

    entry = _first_present(
        nested,
        ("entry_price", "entry", "current_price", "price"),
        _first_present(
            prediction,
            ("entry_price", "entry", "current_price", "price", "last_price"),
            _first_present(
                screener,
                ("entry_price", "current_price", "price", "last_price"),
                0.0,
            ),
        ),
    )

    target = _first_present(
        nested,
        ("target_price", "target", "take_profit"),
        _first_present(
            prediction,
            ("target_price", "target", "predicted_price", "forecast_price"),
            _first_present(
                committee,
                ("target_price", "target", "take_profit"),
                0.0,
            ),
        ),
    )

    stop = _first_present(
        nested,
        ("stop_loss", "stop", "protective_stop"),
        _first_present(
            committee,
            ("stop_loss", "stop", "protective_stop"),
            _first_present(
                screener,
                ("stop_loss", "stop", "protective_stop"),
                0.0,
            ),
        ),
    )

    expected_return = _first_present(
        nested,
        ("expected_return_pct", "expected_return", "return_pct"),
        _first_present(
            prediction,
            (
                "expected_return_pct",
                "expected_return",
                "forecast_return_pct",
                "upside_pct",
            ),
            0.0,
        ),
    )

    return {
        "entry_price": _safe_float(entry),
        "target_price": _safe_float(target),
        "stop_loss": _safe_float(stop),
        "risk_reward_ratio": _safe_float(
            _first_present(
                nested,
                (
                    "risk_reward_ratio",
                    "risk_reward",
                    "rr_ratio",
                ),
                _first_present(
                    committee,
                    (
                        "risk_reward_ratio",
                        "risk_reward",
                        "rr_ratio",
                    ),
                    0.0,
                ),
            )
        ),
        "expected_return_pct": _safe_float(expected_return),
        "downside_risk_pct": _safe_float(
            _first_present(
                nested,
                (
                    "downside_risk_pct",
                    "downside_pct",
                    "risk_pct",
                ),
                0.0,
            )
        ),
        "horizon": str(
            _first_present(
                nested,
                ("horizon", "time_horizon", "holding_period"),
                _first_present(
                    prediction,
                    ("horizon", "time_horizon", "holding_period"),
                    "UNSPECIFIED",
                ),
            )
        ),
    }


