@dataclass
class _AICIOCacheEntry:
    value: Any
    created_at: float
    expires_at: float


class AICIOCache:
    """
    Small thread-safe in-memory TTL cache.

    This cache is process-local and read-only. It does not persist data and
    does not write to the Signal Repository.
    """

    def __init__(
        self,
        *,
        default_ttl_seconds: float = 60.0,
        maximum_entries: int = 64,
    ) -> None:
        self.default_ttl_seconds = max(
            0.0,
            _safe_float(default_ttl_seconds, 60.0),
        )
        self.maximum_entries = max(
            1,
            _safe_int(maximum_entries, 64),
        )

        self._entries: Dict[str, _AICIOCacheEntry] = {}
        self._lock = _RLock()

    def get(self, key: str) -> Any:
        cache_key = str(key or "").strip()

        if not cache_key:
            return None

        now = _monotonic()

        with self._lock:
            entry = self._entries.get(cache_key)

            if entry is None:
                return None

            if entry.expires_at <= now:
                self._entries.pop(cache_key, None)
                return None

            return entry.value

    def set(
        self,
        key: str,
        value: Any,
        *,
        ttl_seconds: Optional[float] = None,
    ) -> Any:
        cache_key = str(key or "").strip()

        if not cache_key:
            raise ValueError("AI CIO cache key cannot be empty")

        ttl = (
            self.default_ttl_seconds
            if ttl_seconds is None
            else max(0.0, _safe_float(ttl_seconds))
        )

        now = _monotonic()

        with self._lock:
            self._purge_expired_locked(now)

            if len(self._entries) >= self.maximum_entries:
                oldest_key = min(
                    self._entries,
                    key=lambda item: self._entries[item].created_at,
                )
                self._entries.pop(oldest_key, None)

            self._entries[cache_key] = _AICIOCacheEntry(
                value=value,
                created_at=now,
                expires_at=now + ttl,
            )

        return value

    def delete(self, key: str) -> bool:
        cache_key = str(key or "").strip()

        with self._lock:
            return self._entries.pop(
                cache_key,
                None,
            ) is not None

    def clear(self) -> None:
        with self._lock:
            self._entries.clear()

    def purge_expired(self) -> int:
        now = _monotonic()

        with self._lock:
            return self._purge_expired_locked(now)

    def _purge_expired_locked(
        self,
        now: float,
    ) -> int:
        expired = [
            key
            for key, entry in self._entries.items()
            if entry.expires_at <= now
        ]

        for key in expired:
            self._entries.pop(key, None)

        return len(expired)

    def stats(self) -> Dict[str, Any]:
        now = _monotonic()

        with self._lock:
            self._purge_expired_locked(now)

            return {
                "entries": len(self._entries),
                "maximum_entries": self.maximum_entries,
                "default_ttl_seconds": self.default_ttl_seconds,
                "keys": sorted(self._entries.keys()),
            }


